# The REDIX API as a systemd service (redix-api #140 R22, #145). It answers HTTPS on 8443 with the certificate it keeps itself, and on 80 only
# to prove the domain to Let's Encrypt and send everyone else to HTTPS (D1); binding port 80 is the one privilege it holds. Its settings
# are REDIX_ variables in /etc/redix/redix.env; the database, its WAL, the attachments and the certificate live in /var/lib/redix.
[Unit]
Description=REDIX API
After=network-online.target
Wants=network-online.target

[Service]
User=redix
Group=redix
EnvironmentFile=/etc/redix/redix.env
ExecStartPre=/usr/local/bin/redix-server migrate
ExecStart=/usr/local/bin/redix-server
Restart=on-failure
RestartSec=2
StateDirectory=redix
WorkingDirectory=/var/lib/redix
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/redix
PrivateTmp=true
MemoryMax=600M

[Install]
WantedBy=multi-user.target
