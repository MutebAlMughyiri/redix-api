# The published server's settings, copied to /etc/redix/redix.env (mode 600, owner root) and filled in there; never in the repository.
# Everything else Prod needs - port 5012 behind Caddy, the database and files under /var/lib/redix - is named in the code
# (internal/platform/environment), as Dev's and QA's are.
REDIX_Environment=Prod

# The tokens' key: 32 random bytes, base64 (openssl rand -base64 32). Changing it signs everyone out.
REDIX_Jwt__SigningKey=

# The first admin, made only on an empty database.
REDIX_Prod_Admin__Username=
REDIX_Prod_Admin__Password=

# The address every email comes from. Prod hands each one to Postfix on this machine (127.0.0.1:25, redix-api #127 and #145).
REDIX_Email__From=

# The domain Caddy keeps the certificate for, and the bucket Litestream and rclone copy to (D5); Caddy and Litestream read them when their
# services load this file too, through a drop-in holding EnvironmentFile=/etc/redix/redix.env.
REDIX_DOMAIN=
REDIX_BACKUP_BUCKET=
REDIX_BACKUP_ENDPOINT=
