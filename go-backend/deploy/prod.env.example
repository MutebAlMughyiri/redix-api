# The published server's settings, the production instance's. Fill a copy named prod.env on the PC, outside the repository; setup.sh installs
# it as /etc/redix/prod.env (mode 600, owner root). Everything else Prod needs - the database and the files under /var/lib/redix/prod, the
# certificates under /var/lib/redix/certificates - is named in the code (internal/platform/environment). qa and dev: qa.env.example.
REDIX_Environment=Prod

# The ports, all here: the API answers HTTPS on the first, and on the second, HTTP, proves the domain to Let's Encrypt and sends everyone to
# HTTPS. 443 is kept for the web front end (#145 R21). setup.sh opens exactly these in the firewall, with SSH's 22.
REDIX_Urls=https://:8443;http://:80

# The domain the API answers HTTPS on; its A record points at the server. The API gets and renews its certificate from Let's Encrypt.
REDIX_Domain=

# The qa and dev instances' names, ";" between them, which this instance's port 80 proves to Let's Encrypt for them: only one process can
# hold port 80 (#145 D-R25). For example qa.redix.muteb.net;dev.redix.muteb.net
REDIX_Certificates__Proves=

# The tokens' key: 32 random bytes, base64 (openssl rand -base64 32). Kept the same on every run: changing it signs everyone out.
REDIX_Jwt__SigningKey=

# The first admin, made only on an empty database.
REDIX_Prod_Admin__Username=
REDIX_Prod_Admin__Password=

# The address every email comes from: no-reply@ on the domain, the same in every instance's file (#147 R5, R10). Prod hands each one to
# Postfix on this machine (127.0.0.1:25, #127 and #145).
REDIX_Email__From=
