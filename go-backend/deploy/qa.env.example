# The qa instance's settings, beside production on the same server, for the testers' qa builds (#145 R25, R26: no API test runs against
# production). Fill a copy named qa.env on the PC, outside the repository; setup.sh installs it as /etc/redix/qa.env (mode 600, owner root).
# dev.env is the same file with Dev, https://:8445, dev.<domain> and /var/lib/redix/dev in place of QA, 8444, qa.<domain> and /var/lib/redix/qa,
# and its web open: REDIX_Web__Urls=https://:9445.
REDIX_Environment=QA

# HTTPS alone, on the instance's own port: production's port 80 proves this name to Let's Encrypt (D-R25). setup.sh opens it in the firewall.
REDIX_Urls=https://:8444

# The web's pages (redix-api #161), on their own HTTPS port with the same certificate: https://:9444 once the owner opens qa's web. Empty keeps
# it closed; without the line, QA's own default, the PC's http://127.0.0.1:5022, would open one on the server's loopback.
REDIX_Web__Urls=

# The instance's own name; its A record points at the server, and production's REDIX_Certificates__Proves lists it.
REDIX_Domain=

# Where the instance keeps its data, and the certificates folder the three share.
REDIX_Database__Path=/var/lib/redix/qa/redix.db
REDIX_Attachments__Folder=/var/lib/redix/qa/attachments
REDIX_Email__Folder=/var/lib/redix/qa/emails
REDIX_Certificates__Folder=/var/lib/redix/certificates

# Its own tokens' key, never production's, so a token from one instance is refused by the others (openssl rand -base64 32).
REDIX_Jwt__SigningKey=

# The instance's first admin, made only on its empty database.
REDIX_Admin__Username=
REDIX_Admin__Password=

# Emails leave through the server's Postfix, as production's do, so a tester receives a reset code. They come from production's no-reply@,
# the one address the domain's mail records sign (#147 R10).
REDIX_Email__Smtp=127.0.0.1:25
REDIX_Email__From=
