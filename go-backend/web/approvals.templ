package web

import (
	"strconv"
	"time"

	"github.com/MutebAlMughyiri/redix-api/go-backend/internal/statement"
)

// approvalsList is Approvals as the app's screen lists them (UC-032, redix-api #167): the filters with their counts and the search; then what
// waits, oldest first, each with a tick, its item and supplier, who entered it from which account, an account that falls short saying so, why
// it could not be approved; Approve selected in the head, shown while something is ticked (D1).
templ approvalsList(p page, shown approvals) {
	<div id="approvals.page" class="approvals">
		<div class="view-head">
			<h2 id="approvals.title">{ p.words.Of("approvals.title") }</h2>
			<span id="approvals.actions" class="head-actions">
				<button id="approvals.history" class="quiet-button" type="button" hx-get="/tab/approvalHistory" hx-target="[id='web.content']">{ p.words.Of("approvals.history") }</button>
				<button id="approvals.approveSelected" class="primary small" type="submit" form="approvals.form" disabled?={ p.finished() }>{ p.words.Of("approvals.approveSelected") }</button>
			</span>
		</div>
		<form
			id="approvals.filters"
			class="filters"
			hx-get="/tab/approvals"
			hx-target="[id='web.content']"
			hx-trigger="change, input changed delay:400ms from:[name='text'], submit"
		>
			<input id="approvals.search" class="search" type="search" name="text" placeholder={ p.words.Of("common.searchIn", p.words.Of("approvals.title")) } aria-label={ p.words.Of("common.searchIn", p.words.Of("approvals.title")) } value={ shown.text }/>
			<fieldset id="approvals.filterChoice" class="picks">
				for _, filter := range approvalFilters {
					<label id={ "approvals." + filter.name } class="pick"><input id={ "approvals." + filter.name + ".input" } type="radio" name="filter" value={ filter.name } checked?={ filter == shown.filter }/>{ p.words.Of(filter.word) + " · " + shown.count(filter) }</label>
				}
			</fieldset>
		</form>
		if len(shown.shown()) == 0 {
			<p id="approvals.empty" class="empty">{ p.words.Of("approvals.empty") }</p>
		} else {
			<form id="approvals.form" hx-post="/approvals/approve" hx-target="[id='web.content']" hx-include="[id='approvals.filters']">
				<div class="grid-wrap">
					<table id="approvals.table" class="grid" hx-on:keydown={ templ.JSUnsafeFuncCall(listKeys) } hx-on:click={ templ.JSUnsafeFuncCall(listSelects) }>
						<thead>
							<tr>
								<th id="approvals.head.tick" class="tick"></th>
								<th id="approvals.head.number">{ p.words.Of("entries.number") }</th>
								<th id="approvals.head.date">{ p.words.Of("expenses.date") }</th>
								<th id="approvals.head.item">{ p.words.Of("contracts.item") }</th>
								<th id="approvals.head.enteredBy">{ p.words.Of("approvals.enteredBy") }</th>
								<th id="approvals.head.amount" class="amount">{ p.words.Of("expenses.amount") }</th>
							</tr>
						</thead>
						<tbody>
							for _, entry := range shown.shown() {
								<tr
									id={ "approvals.card." + entry.ID.String() }
									tabindex="0"
									aria-selected="false"
									hx-get={ "/details/entry/" + entry.ID.String() }
									hx-target="[id='web.details']"
									hx-trigger="click[target.tagName!='INPUT']"
								>
									<td id={ "approvals.tick." + entry.ID.String() } class="tick"><input id={ "approvals.select." + entry.ID.String() } type="checkbox" name="entry" value={ entry.ID.String() } aria-label={ p.words.Of("approvals.approveSelected") }/></td>
									<td id={ "approvals.number." + entry.ID.String() }>{ strconv.FormatInt(entry.Number, 10) }</td>
									<td id={ "approvals.date." + entry.ID.String() }>{ entry.EntryDate.Format(time.DateOnly) }</td>
									<td id={ "approvals.entry." + entry.ID.String() }>
										<span id={ "approvals.item." + entry.ID.String() }>{ entry.ItemName }</span>
										if entry.SupplierName != "" {
											<small id={ "approvals.supplier." + entry.ID.String() } class="hint">{ entry.SupplierName }</small>
										}
										if entry.AccountShortBy.Number() > 0 {
											<small id={ "approvals.short." + entry.ID.String() } class="short">{ p.words.Of("approvals.accountShort", entry.AccountName, statement.Money(entry.AccountBalance.Number()), statement.Money(entry.AccountWaiting.Number()), statement.Money(entry.AccountShortBy.Number())) }</small>
										}
										if shown.failed[entry.ID] != "" {
											<small id={ "approvals.failed." + entry.ID.String() } class="short">{ p.words.Of(shown.failed[entry.ID]) }</small>
										}
									</td>
									<td id={ "approvals.enteredBy." + entry.ID.String() }>{ entry.AuthorName + " · " + entry.AccountName }</td>
									<td id={ "approvals.amount." + entry.ID.String() } class="amount">{ statement.Money(entry.Amount) }</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</form>
		}
	</div>
}

// approvalHistoryPage is the approval history as the app's screen shows it: a search, the kind and the person to narrow by, then each decision -
// what was decided on which entry, a rejection's reason, and who decided it when - newest first, with Show more while there is more.
templ approvalHistoryPage(p page, history approvalHistory) {
	<div class="view-head">
		<h2 id="approvalHistory.title">{ p.words.Of("approvals.history") }</h2>
	</div>
	<form
		id="approvalHistory.filters"
		class="filters"
		hx-get="/tab/approvalHistory"
		hx-target="[id='web.content']"
		hx-trigger="change, input changed delay:400ms from:[name='text'], submit"
	>
		<input id="approvalHistory.search" class="search" type="search" name="text" placeholder={ p.words.Of("common.searchIn", p.words.Of("approvals.history")) } aria-label={ p.words.Of("common.searchIn", p.words.Of("approvals.history")) } value={ history.query.Get("text") }/>
		<fieldset id="approvalHistory.kindChoice" class="picks">
			<legend id="approvalHistory.kindChoice.label">{ p.words.Of("entries.kind") }</legend>
			<label id="approvalHistory.all" class="pick"><input id="approvalHistory.all.input" type="radio" name="kind" value="" checked?={ history.query.Get("kind") == "" }/>{ p.words.Of("history.all") }</label>
			for _, filter := range approvalFilters[1:] {
				<label id={ "approvalHistory.kind." + filter.kind } class="pick"><input id={ "approvalHistory.kind." + filter.kind + ".input" } type="radio" name="kind" value={ filter.kind } checked?={ history.query.Get("kind") == filter.kind }/>{ p.words.Of(filter.word) }</label>
			}
		</fieldset>
		<label id="approvalHistory.personChoice.label" class="pick-select">
			{ p.words.Of("history.person") }
			<select id="approvalHistory.personChoice" name="by">
				<option id="approvalHistory.personChoice.option.none" value="">{ p.words.Of("history.all") }</option>
				for _, member := range history.members {
					<option id={ "approvalHistory.person." + member.ID.String() } value={ member.ID.String() } selected?={ member.ID.String() == history.query.Get("by") }>{ member.DisplayName }</option>
				}
			</select>
		</label>
	</form>
	if len(history.lines) == 0 {
		<p id="approvalHistory.empty" class="empty">{ p.words.Of("history.empty") }</p>
	} else {
		<div class="grid-wrap">
			<table id="approvalHistory.table" class="grid lines">
				<tbody id="approvalHistory.lines">
					@approvalLines(p, history)
				</tbody>
			</table>
		</div>
		@moreHistory(p, history, false)
	}
}

// approvalLines are a page's lines of the approval history.
templ approvalLines(p page, history approvalHistory) {
	for _, line := range history.lines {
		<tr id={ "approvalHistory.line." + strconv.FormatInt(line.ID, 10) }>
			<td id={ "approvalHistory.what." + strconv.FormatInt(line.ID, 10) } class={ "decision", line.Kind.Name() }>{ history.what(p, line) }</td>
			<td id={ "approvalHistory.who." + strconv.FormatInt(line.ID, 10) } class="who">{ history.whoAndWhen(p, line) }</td>
		</tr>
	}
}

// moreHistory is Show more under the approval history while a page was full, adding the next one after the last line; carried out of band beside
// that page, it is gone once there is no more.
templ moreHistory(p page, history approvalHistory, outOfBand bool) {
	if history.more() != "" {
		<button id="approvalHistory.more" class="quiet-button more" type="button" hx-get={ "/approval-history?" + history.more() } hx-target="[id='approvalHistory.lines']" hx-swap="beforeend" { swapOutOfBand(outOfBand)... }>{ p.words.Of("history.more") }</button>
	} else if outOfBand {
		<button id="approvalHistory.more" hx-swap-oob="delete"></button>
	}
}

