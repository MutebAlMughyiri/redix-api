package web

import "strconv"

// registerProject is Register new project in the sign-in's place (UC-066, redix-api #164): the project, its units and partners, and the manager's
// own login, as the app's register form has them; the cursor waits in the project's name. message is the word key of a refusal, or "".
templ registerProject(p page, message string, typed registering) {
	<div class={ templ.KV("signin wide", !p.in), templ.KV("register-tab", p.in) }>
		<form
			id="newProject.form"
			hx-post="/register"
			if p.in {
				hx-target="[id='web.content']"
			} else {
				hx-target="closest .signin"
				hx-swap="outerHTML"
			}
			data-no-connection={ p.words.Of("register.noConnection") }
			hx-on::send-error="const message = this.querySelector('.refusal'); message.textContent = this.dataset.noConnection; message.hidden = false"
		>
			<h1 id="newProject.title">{ p.words.Of("projects.new") }</h1>
			if !p.in {
				<p id="newProject.hint" class="hint">{ p.words.Of("register.hint") }</p>
			}
			if p.notice != "" {
				<p id="newProject.notice" class="notice" role="status">{ p.notice }</p>
			}
			<p id="newProject.message" class="refusal" role="alert" hidden?={ message == "" }>{ p.words.Of(message) }</p>
			<div class="field">
				<label id="newProject.name.label" for="newProject.name">{ p.words.Of("projects.name") }</label>
				<input id="newProject.name" name="name" autofocus required value={ typed.name }/>
			</div>
			<div class="field">
				<label id="newProject.description.label" for="newProject.description">{ p.words.Of("projects.description") }</label>
				<textarea id="newProject.description" name="description" maxlength="2000">{ typed.description }</textarea>
			</div>
			<div class="field">
				<label id="newProject.startDate.label" for="newProject.startDate">{ p.words.Of("projects.startDate") }</label>
				<input id="newProject.startDate" name="startDate" type="date" required value={ typed.startDate }/>
			</div>
			@registerList(p, "units", typed.units, false)
			@registerList(p, "partners", typed.partners, false)
			if p.in {
				<div class="field">
					<label id="newProject.structureSource.label" for="newProject.structureSource">{ p.words.Of("projects.structureSource") }</label>
					<select id="newProject.structureSource" name="structureSource">
						<option id="newProject.structureSource.option.none" value="">{ p.words.Of("projects.defaultTemplate") }</option>
						for _, project := range p.projects {
							if mayOpen(project) {
								<option id={ "newProject.structureSource.option." + project.ID.String() } value={ project.ID.String() }>{ project.Name }</option>
							}
						}
					</select>
				</div>
			} else {
				@managerLogin(p, typed)
			}
			<button id="newProject.submit" class="primary" type="submit">{ p.words.Of("projects.create") }</button>
			<div class="form-links">
				if p.in {
					<a id="newProject.cancel" href="#" hx-delete="/tab/registerProject" hx-target="[id='web.content']">{ p.words.Of("common.cancel") }</a>
				} else {
					<a id="newProject.cancel" href="#" hx-get="/sign-in" hx-target="closest .signin" hx-swap="outerHTML">{ p.words.Of("common.cancel") }</a>
				}
			</div>
		</form>
	</div>
}

// managerLogin is the manager's own login, which a registration from the sign-in asks and a signed-in person's does not: they are its manager.
templ managerLogin(p page, typed registering) {
	<h2 id="newProject.managerHeading" class="section">{ p.words.Of("projects.manager") }</h2>
	<div class="field">
		<label id="newProject.managerName.label" for="newProject.managerName">{ p.words.Of("users.name") }</label>
		<input id="newProject.managerName" name="displayName" required value={ typed.displayName }/>
		<small id="newProject.managerName.hint" class="hint">{ p.words.Of("users.nameHint") }</small>
	</div>
	<div class="field">
		<label id="newProject.username.label" for="newProject.username">{ p.words.Of("users.username") }</label>
		<input id="newProject.username" name="username" autocomplete="username" required value={ typed.username }/>
	</div>
	<div class="field">
		<label id="newProject.mobile.label" for="newProject.mobile">{ p.words.Of("users.mobile") }</label>
		<input id="newProject.mobile" name="mobile" type="tel" autocomplete="tel" value={ typed.mobile }/>
	</div>
	<div class="field">
		<label id="newProject.password.label" for="newProject.password">{ p.words.Of("signIn.password") }</label>
		<input id="newProject.password" name="password" type="password" autocomplete="new-password" required/>
		<small id="newProject.password.hint" class="hint">{ p.words.Of("common.passwordRules") }</small>
	</div>
	<p id="legal.agreement" class="hint">{ p.words.Of("legal.agreement") }</p>
}

// registerList is the form's units or partners: a field to type one and Add, the ones added each with Remove, kept in the form as hidden values.
// Add and Remove answer this list alone, so nothing else typed is sent or lost; Enter in its field adds, as the app's field does, and the cursor
// waits in the field again for the next one when focus is true.
templ registerList(p page, list string, items []string, focus bool) {
	<fieldset id={ "newProject." + list } class="list-field">
		<legend id={ "newProject." + list + "Heading" }>{ p.words.Of(listWords[list].heading) }</legend>
		<div class="toolbar">
			<input
				id={ "newProject." + listWords[list].field + "Name" }
				name={ listWords[list].field + "Name" }
				aria-label={ p.words.Of(listWords[list].name) }
				placeholder={ p.words.Of(listWords[list].name) }
				autofocus?={ focus }
				hx-on:keydown="if (event.key === 'Enter') { event.preventDefault(); this.nextElementSibling.click() }"
			/>
			<button
				id={ "newProject.add" + listWords[list].title }
				class="quiet-button"
				type="button"
				hx-post={ "/register/" + list }
				hx-params={ listWords[list].field + "," + listWords[list].field + "Name" }
				hx-target={ "[id='newProject." + list + "']" }
				hx-swap="outerHTML"
			>{ p.words.Of(listWords[list].add) }</button>
		</div>
		<div class="chips">
			for index, item := range items {
				<span id={ "newProject." + listWords[list].field + "." + strconv.Itoa(index) } class="chip">
					<input type="hidden" name={ listWords[list].field } value={ item }/>
					{ item }
					<button
						class="remove"
						type="button"
						aria-label={ p.words.Of("swipe.remove") }
						hx-post={ "/register/" + list }
						hx-params={ listWords[list].field + ",remove" }
						hx-vals={ `{"remove":"` + strconv.Itoa(index) + `"}` }
						hx-target={ "[id='newProject." + list + "']" }
						hx-swap="outerHTML"
					>✕</button>
				</span>
			}
		</div>
	</fieldset>
}
