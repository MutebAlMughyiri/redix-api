package web

import "strconv"

// settingsPage is Settings as the app's screen shows it: who is signed in and their role here; Switch project and the default project, from
// the top bar's list; Registered projects for whoever approves them; the language; the appearance; how many entries the home lists; My email;
// Change password; My history; the privacy policy and the terms of use; Sign out; and the version. No fingerprint row: the web has none (D1).
templ settingsPage(p page, theme string, entriesShown int) {
	<div class="view-head"><h2 id="sharedSettings.title">{ p.words.Of("sharedSettings.title") }</h2></div>
	<div id="sharedSettings.body" class="settings">
		<section id="sharedSettings.who" class="setting">
			<h3 id="sharedSettings.who.title">{ p.person }</h3>
			<small id="sharedSettings.who.subtitle" class="hint">{ parts(p.caller.Username, p.project.RoleName) }</small>
		</section>
		<section id="sharedSettings.projects" class="setting">
			<button id="sharedSettings.switchProject" class="quiet-button" type="button" popovertarget="web.projects">{ p.words.Of("sharedSettings.switchProject") }</button>
			<button id="sharedSettings.defaultProject" class="quiet-button" type="button" popovertarget="web.projects">{ p.words.Of("sharedSettings.defaultProject") }</button>
			<small id="sharedSettings.defaultProject.hint" class="hint">{ p.words.Of("sharedSettings.defaultProjectHint") }</small>
			if p.mayApproveProjects() {
				<button id="sharedSettings.registered" class="quiet-button" type="button" disabled>{ p.words.Of("registered.title") }</button>
			}
		</section>
		<section id="web.setting.language" class="setting">
			<h3 id="myAccount.language">{ p.words.Of("myAccount.language") }</h3>
			@languageChoice(p)
		</section>
		<section id="sharedSettings.appearance" class="setting">
			<h3 id="sharedSettings.appearance.title">{ p.words.Of("sharedSettings.appearance") }</h3>
			<nav id="sharedSettings.themeChoice" class="segmented" aria-label={ p.words.Of("sharedSettings.appearance") }>
				for _, choice := range themes {
					<a id={ "sharedSettings.theme." + choice } href={ templ.SafeURL("/theme/" + choice) } aria-current={ strconv.FormatBool(choice == theme || (choice == "system" && theme == "")) }>{ p.words.Of(themeWord(choice)) }</a>
				}
			</nav>
		</section>
		<section id="sharedSettings.entriesShown" class="setting">
			<label id="sharedSettings.entriesShown.title" for="sharedSettings.entriesShownChoice">{ p.words.Of("sharedSettings.entriesShown") }</label>
			<small id="sharedSettings.entriesShown.subtitle" class="hint">{ p.words.Of("sharedSettings.entriesShownHint") }</small>
			<select id="sharedSettings.entriesShownChoice" name="count" hx-post="/entries-shown" hx-trigger="change" hx-target="[id='web.content']">
				for _, count := range entriesShownChoices {
					<option id={ "sharedSettings.entriesShownOption." + strconv.Itoa(count) } value={ strconv.Itoa(count) } selected?={ count == entriesShown }>{ strconv.Itoa(count) }</option>
				}
			</select>
		</section>
		<section id="sharedSettings.account" class="setting">
			<button id="sharedSettings.changePassword" class="quiet-button" type="button" hx-get="/tab/changePassword" hx-target="[id='web.content']">{ p.words.Of("myAccount.changePassword") }</button>
			<button id="sharedSettings.myHistory" class="quiet-button" type="button" hx-get="/tab/myHistory" hx-target="[id='web.content']">{ p.words.Of("history.myTitle") }</button>
			<a id="legal.privacy" href="/privacy" target="_blank" rel="noopener">{ p.words.Of("legal.privacy") }</a>
			<a id="legal.terms" href="/terms" target="_blank" rel="noopener">{ p.words.Of("legal.terms") }</a>
			<button id="sharedSettings.signOut" class="signout" type="button" hx-post="/sign-out" hx-target="[id='web.shell']" hx-swap="outerHTML">{ p.words.Of("myAccount.signOut") }</button>
		</section>
		<p id="sharedSettings.version" class="hint">{ p.words.Of("app.version") + " " + Version }<bdi>{ build }</bdi></p>
	</div>
}

// changePasswordTab is Change password in its tab, from Settings, as the app's screen: the form the first sign-in asks too.
templ changePasswordTab(p page) {
	@changePasswordForm(p, "", p.caller.Username)
}
