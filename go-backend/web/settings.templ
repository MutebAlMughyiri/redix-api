package web

import "strconv"

// settingsMenu is Settings as My account opens it, a list beside its menu on hover or focus, where the app has a screen (the owner, 23 Nov
// 2026, findings row 321): the language and the appearance, switched at once; My email, with the address the account holds, in the details
// panel; Change password and, for whoever approves them, Registered projects, in their tabs; the privacy policy and the terms of use, each an
// item of its own; and the version - switching project and the default are the top bar's project list's (findings row 323). Who is signed in, My history and Sign out are My account's own. No
// fingerprint row (D1); no count of the home's entries (findings row 306).
templ settingsMenu(p page) {
	<div id="web.settings" class="sub">
		<button id="web.sharedSettings" class="choice sub-head" type="button" aria-haspopup="menu">
			{ p.words.Of("sharedSettings.title") }
			<span id="web.sharedSettings.arrow" class="arrow" aria-hidden="true">{ arrow }</span>
		</button>
		<div id="web.settingsMenu" class="submenu">
			<div id="web.setting.language" class="sub-row">
				<span id="myAccount.language" class="label">{ p.words.Of("myAccount.language") }</span>
				@languageChoice(p)
			</div>
			<div id="sharedSettings.appearance" class="sub-row">
				<span id="sharedSettings.appearance.title" class="label">{ p.words.Of("sharedSettings.appearance") }</span>
				<nav id="sharedSettings.themeChoice" class="segmented" aria-label={ p.words.Of("sharedSettings.appearance") }>
					for _, choice := range themes {
						<a id={ "sharedSettings.theme." + choice } href={ templ.SafeURL("/theme/" + choice) } aria-current={ strconv.FormatBool(choice == p.theme || (choice == "system" && p.theme == "")) }>{ p.words.Of(themeWord(choice)) }</a>
					}
				</nav>
			</div>
			<button id="sharedSettings.changeEmail" class="choice sub-choice" type="button" hx-get="/details/my-email" hx-target="[id='web.details']" hx-on:click="document.getElementById('web.accountMenu').hidePopover()">
				{ p.words.Of("settings.myEmail") }
				<small id="sharedSettings.myEmail.subtitle" class="hint">{ p.email }</small>
			</button>
			<button id="sharedSettings.changePassword" class="choice" type="button" hx-get="/tab/changePassword" hx-target="[id='web.content']" hx-on:click="document.getElementById('web.accountMenu').hidePopover()">{ p.words.Of("myAccount.changePassword") }</button>
			if p.mayApproveProjects() {
				<button id="sharedSettings.registered" class="choice" type="button" hx-get="/tab/registered" hx-target="[id='web.content']" hx-on:click="document.getElementById('web.accountMenu').hidePopover()">{ p.words.Of("registered.title") }</button>
			}
			<a id="legal.privacy" class="choice" href="/privacy" target="_blank" rel="noopener">{ p.words.Of("legal.privacy") }</a>
			<a id="legal.terms" class="choice" href="/terms" target="_blank" rel="noopener">{ p.words.Of("legal.terms") }</a>
			<p id="sharedSettings.version" class="hint sub-version">{ p.words.Of("app.version") + " " + Version }<bdi>{ build }</bdi></p>
		</div>
	</div>
}

// myEmailKept carries the email just confirmed into Settings' list, out of band, the details panel closing beside it (UC-010).
templ myEmailKept(email string) {
	<small id="sharedSettings.myEmail.subtitle" class="hint" hx-swap-oob="true">{ email }</small>
}

// changePasswordTab is Change password in its tab, from Settings' list, as the app's screen: the form the first sign-in asks too.
templ changePasswordTab(p page) {
	@changePasswordForm(p, "", p.caller.Username)
}
