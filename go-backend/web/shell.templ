package web

import "strconv"

// htmxConfig has htmx swap a refusal, answered 422 with its form, and keep its own styles out of the page (#161 S4).
const htmxConfig = `{"responseHandling":[{"code":"204","swap":false},{"code":"[23]..","swap":true},{"code":"422","swap":true},{"code":"[45]..","swap":false,"error":true}],"includeIndicatorStyles":false}`

// document is the whole page: the shell in its language, the stylesheet, and htmx, the one script (#80 R19). Alt+1 folds and unfolds the side menu
// from anywhere, as its arrows do, by the key's place, so an Arabic keyboard's 1 counts (#161 R7); it is the key's one handler.
templ document(p page) {
	<!DOCTYPE html>
	<html lang={ p.language } dir={ p.direction() }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>REDIX</title>
			<link rel="icon" href={ logoIcon }/>
			<meta name="htmx-config" content={ htmxConfig }/>
			<link rel="stylesheet" href={ p.assets.css }/>
			<script src={ p.assets.htmx } defer></script>
		</head>
		<body hx-on:keydown="if (event.altKey && event.code === 'Digit1' && document.getElementById('web.view.sideMenu')) { event.preventDefault(); document.getElementById('web.view.sideMenu').click() }">
			@shell(p)
		</body>
	</html>
}

// shell is the frame every page lives in, the base design the owner approved on 21 Nov 2026: top bar, side menu, tabs and content, status bar
// (#161 R5). Before signing in, only the top bar, the content and the status bar.
templ shell(p page) {
	<div id="web.shell" class={ "shell", templ.KV("in", p.in), templ.KV("arriving", p.arriving) } style={ p.view.width() }>
		@topBar(p)
		if p.in {
			@side(p)
			<div
				id="web.sideLine"
				class="sash"
				aria-hidden="true"
				hx-on:pointerdown="this.setPointerCapture(event.pointerId); this.closest('.shell').classList.add('resizing')"
				hx-on:pointermove="if (!this.hasPointerCapture(event.pointerId)) return; const shell = this.closest('.shell'), box = shell.getBoundingClientRect(), along = getComputedStyle(shell).direction === 'rtl' ? box.right - event.clientX : event.clientX - box.left, width = Math.round(Math.max(180, Math.min(480, box.width - 320, along))); shell.style.setProperty('--side-w', width + 'px'); document.getElementById('web.view.width').value = width"
				hx-on:lostpointercapture="this.closest('.shell').classList.remove('resizing'); htmx.trigger(document.getElementById('web.viewMenu'), 'change')"
			></div>
		}
		<main class="main">
			if p.in {
				@tabsRow(p)
			}
			<div id="web.content" class="content">
				@p.content
			</div>
		</main>
		@statusBar(p)
	</div>
}

// topBar holds the logo and, once someone is signed in, the project they work in - its button lists their projects, as the app's project list
// does (redix-api #165) - their name and Sign out (#161 R6).
templ topBar(p page) {
	<header id="web.topBar" class="top">
		<div id="web.brand" class="brand">
			@logo()
			<span>{ p.words.Of("app.title") }</span>
		</div>
		if p.in {
			<button id="web.project" class="project" type="button" popovertarget="web.projects">
				if p.inProject() {
					{ p.project.Name }
				} else {
					{ p.words.Of("projects.choose") }
				}
				<span class="caret">▾</span>
			</button>
			<div id="web.projects" class="menu-pop projects-menu" popover>
				@projectMenu(p, "")
			</div>
		}
		if p.person != "" {
			<div class="end">
				<span id="web.person" class="who">{ p.person }</span>
				<button id="myAccount.signOut" class="signout" type="button" hx-post="/sign-out" hx-target="[id='web.shell']" hx-swap="outerHTML">{ p.words.Of("myAccount.signOut") }</button>
			</div>
		}
	</header>
}

// logo is REDIX's mark, the one picture (#80 R19).
templ logo() {
	@templ.Raw(logoSVG)
}

// side is the side menu, like a project explorer, folded by a keyboard character beside the project's name or Alt+1 (#161 R7).
templ side(p page) {
	<aside id="web.sideMenu" class="side" aria-label={ p.words.Of("web.sideMenu") }>
		<div class="side-head">
			<span id="web.sideProject" class="side-project">{ p.project.Name }</span>
			<label id="web.fold" class="fold" for="web.view.sideMenu" data-tip={ p.shortcut("web.collapse") }>{ p.foldArrow() }</label>
		</div>
		@tree(p)
	</aside>
}

// tree is the side menu's items: one whose feature is built opens its tab, the others stand gray (#161 R15).
templ tree(p page) {
	<ul id="web.tree" class="tree">
		for _, item := range sideMenu {
			<li>
				if item.built() {
					@itemLink(p, item, false)
				} else {
					<span id={ "web.item." + item.name } class="parked" aria-disabled="true">{ p.words.Of(item.title) }</span>
				}
			</li>
		}
	</ul>
}

// itemLink is a built item's link, marked while its tab is in front.
templ itemLink(p page, item menuItem, outOfBand bool) {
	<a id={ "web.item." + item.name } href="#" hx-get={ "/tab/" + item.name } hx-target="[id='web.content']" aria-current={ strconv.FormatBool(item.name == p.view.Active) } { swapOutOfBand(outOfBand)... }>{ p.words.Of(item.title) }</a>
}

// itemLinks are every built item's link, carried beside a tab's content so the one in front is marked; the items themselves stay in place.
templ itemLinks(p page) {
	for _, item := range sideMenu {
		if item.built() {
			@itemLink(p, item, true)
		}
	}
}

// tabsRow is the arrow that brings the side menu back, the open tabs, and the View menu, whose ticks the whole shell's look follows (#161 R9).
templ tabsRow(p page) {
	<div class="tabs-row">
		<label id="web.unfold" class="unfold" for="web.view.sideMenu" data-tip={ p.shortcut("web.showMenu") }>{ p.unfoldArrow() }</label>
		@tabs(p, false)
		<button id="web.view" class="view-button" type="button" popovertarget="web.viewMenu">{ p.words.Of("web.view") }</button>
		<form id="web.viewMenu" class="view-menu" popover hx-post="/view" hx-trigger="change" hx-swap="none">
			<label><input type="checkbox" id="web.view.topBar" name="top" checked?={ p.view.Top }/>{ p.words.Of("web.topBar") }</label>
			<label><input type="checkbox" id="web.view.statusBar" name="status" checked?={ p.view.Status }/>{ p.words.Of("web.statusBar") }</label>
			<label><input type="checkbox" id="web.view.sideMenu" name="side" checked?={ p.view.Side }/>{ p.words.Of("web.sideMenu") }<kbd>Alt+1</kbd></label>
			<input type="checkbox" id="web.view.summary" name="summary" checked?={ p.view.Summary } hidden/>
			<input type="hidden" id="web.view.width" name="width" value={ strconv.Itoa(p.view.Width) }/>
		</form>
	</div>
}

// tabs are the open tabs, the front one marked.
templ tabs(p page, outOfBand bool) {
	<div id="web.tabs" class="tabs" role="tablist" { swapOutOfBand(outOfBand)... }>
		for _, item := range p.openTabs() {
			<div id={ "web.tab." + item.name } class="tab" role="tab" aria-selected={ strconv.FormatBool(item.name == p.view.Active) }>
				<button id={ "web.tab." + item.name + ".title" } class="tab-title" type="button" hx-get={ "/tab/" + item.name } hx-target="[id='web.content']">{ p.words.Of(item.title) }</button>
				<button id={ "web.tab." + item.name + ".close" } class="close" type="button" hx-delete={ "/tab/" + item.name } hx-target="[id='web.content']" aria-label={ p.words.Of("web.close") }>✕</button>
			</div>
		}
	</div>
}

// statusBar is the host this page came from and the web's version (#161 R2).
templ statusBar(p page) {
	<footer id="web.statusBar" class="status">
		<span id="web.host" class="host"><span class="dot"></span>{ p.host }</span>
		<span id="appVersion.line" class="end">{ p.words.Of("app.version") + " " + Version }<bdi>{ build }</bdi></span>
	</footer>
}

// emptyContent is the content area before a tab is open.
templ emptyContent(p page) {
	<p id="web.pickFromMenu" class="empty">{ p.words.Of("web.pickFromMenu") }</p>
}

// signInForm is the sign-in, in the content area: what the app's sign-in has, with the language at its foot, since Settings cannot be reached before
// signing in (#161 R2, R12, R19). The cursor waits in Username, or in Password when a refusal kept the username (#76 row 286). message is the
// word key of a refusal, or ""; p.notice says what just happened, as after a reset.
templ signInForm(p page, message string, username string) {
	<div class="signin">
		<form
			id="signIn.form"
			hx-post="/sign-in"
			hx-target="closest .signin"
			hx-swap="outerHTML"
			data-no-connection={ p.words.Of("signIn.noConnection") }
			hx-on::send-error="const message = this.querySelector('.refusal'); message.textContent = this.dataset.noConnection; message.hidden = false"
		>
			<h1 id="signIn.title">{ p.words.Of("app.title") }</h1>
			<p id="signIn.hint" class="hint">{ p.words.Of("signIn.hint") }</p>
			<p id="signIn.notice" class="notice" role="status" hidden?={ p.notice == "" }>{ p.words.Of(p.notice) }</p>
			<div class="field">
				<label for="signIn.username">{ p.words.Of("signIn.username") }</label>
				<input id="signIn.username" name="username" autocomplete="username" autofocus?={ username == "" } required value={ username }/>
			</div>
			<div class="field">
				<label for="signIn.password">{ p.words.Of("signIn.password") }</label>
				<input id="signIn.password" name="password" type="password" autocomplete="current-password" autofocus?={ username != "" } required/>
			</div>
			<p id="signIn.message" class="refusal" role="alert" hidden?={ message == "" }>{ p.words.Of(message) }</p>
			<button id="signIn.submit" class="primary" type="submit">{ p.words.Of("signIn.submit") }</button>
			<div class="form-links">
				<a id="signIn.registerProject" href="#" hx-get="/register" hx-target="closest .signin" hx-swap="outerHTML">{ p.words.Of("signIn.registerProject") }</a>
				<a id="auth.forgotPassword" href="#" hx-get="/forgot-password" hx-target="closest .signin" hx-swap="outerHTML">{ p.words.Of("auth.forgotPassword") }</a>
			</div>
			<div class="form-language">
				@languageChoice(p)
			</div>
		</form>
	</div>
}

// forgotPasswordForm is Forgot password, in the sign-in's place (UC-002, AC-02.6): the username or email and Send, then, once a code is sent,
// the code and the new password twice, as the app's screen has them. Two forms in one box, so Enter in the login sends and Enter below resets;
// the reset carries the login the code was sent for. message is the word key of a refusal, or "".
templ forgotPasswordForm(p page, message string, login string, sent bool) {
	<div class="signin">
		<div
			data-no-connection={ p.words.Of("auth.noConnection") }
			hx-on::send-error="const message = this.querySelector('.refusal'); message.textContent = this.dataset.noConnection; message.hidden = false"
		>
			<h1 id="forgotPassword.title">{ p.words.Of("auth.forgotPassword") }</h1>
			<p id="forgotPassword.message" class="refusal" role="alert" hidden?={ message == "" }>{ p.words.Of(message) }</p>
			<form id="forgotPassword.sendForm" hx-post="/forgot-password" hx-target="closest .signin" hx-swap="outerHTML">
				<div class="field">
					<label for="forgotPassword.login">{ p.words.Of("auth.loginOrEmail") }</label>
					<input id="forgotPassword.login" name="login" autocomplete="username" autofocus?={ !sent } required value={ login }/>
				</div>
				if sent {
					<input type="hidden" name="sent" value="true"/>
				}
				<button id="forgotPassword.send" class="secondary" type="submit">{ p.words.Of("auth.sendCode") }</button>
			</form>
			if sent {
				<p id="forgotPassword.sent" class="notice" role="status">{ p.words.Of("auth.codeSent") }</p>
				<form id="forgotPassword.form" hx-post="/reset-with-code" hx-target="closest .signin" hx-swap="outerHTML">
					<input type="text" name="login" autocomplete="username" value={ login } hidden/>
					<div class="field">
						<label for="forgotPassword.code">{ p.words.Of("auth.code") }</label>
						<input id="forgotPassword.code" name="code" inputmode="numeric" autocomplete="one-time-code" autofocus required/>
					</div>
					<div class="field">
						<label for="forgotPassword.new">{ p.words.Of("changePassword.new") }</label>
						<input id="forgotPassword.new" name="new" type="password" autocomplete="new-password" required/>
					</div>
					<div class="field">
						<label for="forgotPassword.confirm">{ p.words.Of("changePassword.confirm") }</label>
						<input id="forgotPassword.confirm" name="confirm" type="password" autocomplete="new-password" required/>
					</div>
					<button id="forgotPassword.reset" class="primary" type="submit">{ p.words.Of("auth.resetWithCode") }</button>
				</form>
			}
			<div class="form-links">
				<a id="forgotPassword.cancel" href="#" hx-get="/sign-in" hx-target="closest .signin" hx-swap="outerHTML">{ p.words.Of("common.cancel") }</a>
			</div>
		</div>
	</div>
}

// changePasswordForm replaces a temporary password before anything else (AC-02.1, #161 R13), in the content area; the hidden username tells a
// password manager whose password it is (R19). message is the word key of a refusal, or "".
templ changePasswordForm(p page, message string, username string) {
	<div class="signin">
		<form
			id="changePassword.form"
			hx-post="/change-password"
			hx-target="closest .signin"
			hx-swap="outerHTML"
			data-no-connection={ p.words.Of("changePassword.noConnection") }
			hx-on::send-error="const message = this.querySelector('.refusal'); message.textContent = this.dataset.noConnection; message.hidden = false"
		>
			<h1 id="changePassword.title">{ p.words.Of("changePassword.title") }</h1>
			<p id="changePassword.hint" class="hint">{ p.words.Of("changePassword.hint") }</p>
			<input type="text" name="username" autocomplete="username" value={ username } hidden/>
			<div class="field">
				<label for="changePassword.current">{ p.words.Of("changePassword.current") }</label>
				<input id="changePassword.current" name="current" type="password" autocomplete="current-password" autofocus required/>
			</div>
			<div class="field">
				<label for="changePassword.new">{ p.words.Of("changePassword.new") }</label>
				<input id="changePassword.new" name="new" type="password" autocomplete="new-password" required/>
			</div>
			<div class="field">
				<label for="changePassword.confirm">{ p.words.Of("changePassword.confirm") }</label>
				<input id="changePassword.confirm" name="confirm" type="password" autocomplete="new-password" required/>
			</div>
			<p id="changePassword.message" class="refusal" role="alert" hidden?={ message == "" }>{ p.words.Of(message) }</p>
			<button id="changePassword.submit" class="primary" type="submit">{ p.words.Of("changePassword.submit") }</button>
		</form>
	</div>
}

// settingsTab is Settings: the language, chosen here and never in the top bar (#161 R11).
templ settingsTab(p page) {
	<div class="view-head"><h2 id="sharedSettings.title">{ p.words.Of("sharedSettings.title") }</h2></div>
	<section id="web.setting.language" class="setting">
		<h3 id="myAccount.language">{ p.words.Of("myAccount.language") }</h3>
		@languageChoice(p)
	</section>
}

// languageChoice is the two languages, the one in use marked; choosing one draws the page again in it (#161 S6).
templ languageChoice(p page) {
	<nav id="web.language" class="language" aria-label={ p.words.Of("myAccount.language") }>
		<a id="myAccount.arabic" href="/language/ar" lang="ar" aria-current={ strconv.FormatBool(p.language == "ar") }>{ p.words.Of("myAccount.arabic") }</a>
		<a id="myAccount.english" href="/language/en" lang="en" aria-current={ strconv.FormatBool(p.language == "en") }>{ p.words.Of("myAccount.english") }</a>
	</nav>
}
