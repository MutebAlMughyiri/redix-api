package web

import "strconv"

// htmxConfig has htmx swap a refusal, answered 422 with its form, and keep its own styles out of the page (#161 S4); and settle new content at once:
// htmx binds a swapped part's own triggers when it settles, 20 ms later by default, for transitions the shell has none of, and a person or a test
// typing into a list's filters within those 20 ms was not heard (redix-api #166).
const htmxConfig = `{"responseHandling":[{"code":"204","swap":false},{"code":"[23]..","swap":true},{"code":"422","swap":true},{"code":"[45]..","swap":false,"error":true}],"includeIndicatorStyles":false,"defaultSettleDelay":0}`

// document is the whole page: the shell in its language, the stylesheet, and htmx, the one script (#80 R19). Its keydown is the one handler of the
// shell's own keys: Alt+1 folds and unfolds the side menu from anywhere, as its arrows do, by the key's place, so an Arabic keyboard's 1 counts
// (#161 R7); Alt+W closes the tab in front, by its place too (findings row 308); Esc hides the details panel from anywhere, a menu open aside, and gives the row it showed the focus again (redix-api #166).
templ document(p page) {
	<!DOCTYPE html>
	<html
		lang={ p.language }
		dir={ p.direction() }
		if p.theme != "" {
			data-theme={ p.theme }
		}
	>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>REDIX</title>
			<link rel="icon" href={ logoIcon }/>
			<meta name="htmx-config" content={ htmxConfig }/>
			<link rel="stylesheet" href={ p.assets.css }/>
			<script src={ p.assets.htmx } defer></script>
		</head>
		<body hx-on:keydown={ templ.JSUnsafeFuncCall(shellKeys) } hx-on::after-settle={ templ.JSUnsafeFuncCall(followSelection) } hx-on::load={ templ.JSUnsafeFuncCall(partialTicks) }>
			@shell(p)
		</body>
	</html>
}

// shell is the frame every page lives in, the base design the owner approved on 21 Nov 2026: top bar, side menu, tabs and content, status bar
// (#161 R5). Before signing in, only the top bar, the content and the status bar.
templ shell(p page) {
	<div id="web.shell" class={ "shell", templ.KV("in", p.in), templ.KV("arriving", p.arriving) } style={ p.view.widths() }>
		@topBar(p)
		if p.in {
			@side(p)
			@dragLine("web.sideLine", "side-line", ".shell", "start", "--side-w", "web.view.width", narrowest, widest)
		}
		<main class="main">
			if p.in {
				@tabsRow(p)
			}
			<div id="web.content" class="content">
				@p.content
			</div>
			if p.in {
				@detailsPanel(false) {
					@p.details
				}
				@dragLine("web.detailsLine", "details-line", ".main", "end", "--details-w", "web.view.detailsWidth", detailsNarrowest, detailsWidest)
			}
		</main>
		@statusBar(p)
	</div>
}

// topBar holds the logo and, once someone is signed in, the project they work in - its button lists their projects, as the app's project list
// does (redix-api #165) - their name and Sign out (#161 R6).
templ topBar(p page) {
	<header id="web.topBar" class="top">
		<div id="web.brand" class="brand">
			@logo()
			<span id="web.appTitle">{ p.words.Of("app.title") }</span>
		</div>
		if p.in {
			@projectButton(p, false)
			<div id="web.projects" class="menu-pop projects-menu" popover>
				@projectMenu(p, "")
			</div>
		}
		if p.person != "" {
			<div class="end">
				<button id="web.notifications" class="quiet-button" type="button" hx-get="/tab/notifications" hx-target="[id='web.content']">
					{ p.words.Of("notifications.title") }
					<span id="web.notifications.count" class="chip" hidden hx-get="/notifications/count" hx-trigger="load" hx-target="this" hx-swap="outerHTML"></span>
				</button>
			</div>
		}
	</header>
}

// projectButton is the top bar's button naming the project the person works in, which opens the list to choose another; carried out of band
// once More info renames it (redix-api #175).
templ projectButton(p page, outOfBand bool) {
	<button id="web.project" class="project" type="button" popovertarget="web.projects" { swapOutOfBand(outOfBand)... }>
		if p.inProject() {
			{ p.project.Name }
		} else {
			{ p.words.Of("projects.choose") }
		}
		<span id="web.project.caret" class="caret" aria-hidden="true">▾</span>
	</button>
}

// logo is REDIX's mark, the one picture (#80 R19).
templ logo() {
	@templ.Raw(logoSVG)
}

// side is the side menu, like a project explorer, folded by a keyboard character beside the project's name or Alt+1 (#161 R7).
templ side(p page) {
	<aside id="web.sideMenu" class="side" aria-label={ p.words.Of("web.sideMenu") }>
		<div class="side-head">
			<span id="web.sideProject" class="side-project">{ p.project.Name }</span>
			<label id="web.fold" class="fold" for="web.view.sideMenu" data-tip={ p.shortcut("web.collapse", "Alt+1") }>{ p.foldArrow() }</label>
		</div>
		@tree(p)
	</aside>
}

// tree is the side menu's items, those used every day and then More - its arrow alone, in the middle, its word read only by a screen reader -
// folded until it is clicked, over those used now and then (findings rows 307, 311): one whose feature is built opens its tab, one that hands a file over hands it, the others stand gray (#161 R15).
templ tree(p page) {
	<ul id="web.tree" class="tree">
		@treeItems(p, dailyMenu)
		<li id="web.tree.more">
			<details id="web.more" class="more" open?={ p.foldedOpen() }>
				<summary id="web.more.toggle" aria-label={ p.words.Of("history.more") }><span id="web.more.arrow" class="arrow" aria-hidden="true">{ arrow }</span></summary>
				<ul id="web.moreItems" class="tree">
					@treeItems(p, foldedMenu)
				</ul>
			</details>
		</li>
	</ul>
}

// treeItems are items of the side menu, those p's caller may use.
templ treeItems(p page, items []menuItem) {
	for _, item := range items {
		if p.offers(item.name) {
			<li id={ "web.tree." + item.name }>
				if path, hands := handsOver[item.name]; hands {
					<a id={ "web.item." + item.name } href={ templ.SafeURL(path) } download>{ p.words.Of(item.title) }</a>
				} else if item.built() {
					@itemLink(p, item, false)
				} else {
					<span id={ "web.item." + item.name } class="parked" aria-disabled="true">{ p.words.Of(item.title) }</span>
				}
			</li>
		}
	}
}

// itemLink is a built item's link, marked while its tab is in front.
templ itemLink(p page, item menuItem, outOfBand bool) {
	<a id={ "web.item." + item.name } href="#" hx-get={ "/tab/" + item.name } hx-target="[id='web.content']" aria-current={ strconv.FormatBool(item.name == p.view.Active) } { swapOutOfBand(outOfBand)... }>{ p.words.Of(item.title) }</a>
}

// itemLinks are every built item's link, carried beside a tab's content so the one in front is marked; the items themselves stay in place.
templ itemLinks(p page) {
	for _, item := range sideMenu {
		if item.built() && p.offers(item.name) {
			@itemLink(p, item, true)
		}
	}
}

// tabsRow is the arrow that brings the side menu back, the open tabs, and the View menu, whose ticks the whole shell's look follows (#161 R9),
// opened by the web's arrow, down, its word read only by a screen reader (findings row 317).
// Its saves queue, the last one sent after the one on its way, so lines dragged quickly over a slow network keep the width they were left at.
templ tabsRow(p page) {
	<div class="tabs-row">
		<label id="web.unfold" class="unfold" for="web.view.sideMenu" data-tip={ p.shortcut("web.showMenu", "Alt+1") }>{ p.unfoldArrow() }</label>
		@tabs(p, false)
		<button id="web.view" class="view-button" type="button" popovertarget="web.viewMenu" aria-haspopup="menu" aria-label={ p.words.Of("web.view") }><span id="web.view.arrow" class="arrow" aria-hidden="true">{ arrow }</span></button>
		<form id="web.viewMenu" class="view-menu" popover hx-post="/view" hx-trigger="change" hx-swap="none" hx-sync="this:queue last">
			<label id="web.view.topBar.label"><input type="checkbox" id="web.view.topBar" name="top" checked?={ p.view.Top }/>{ p.words.Of("web.topBar") }</label>
			<label id="web.view.statusBar.label"><input type="checkbox" id="web.view.statusBar" name="status" checked?={ p.view.Status }/>{ p.words.Of("web.statusBar") }</label>
			<label id="web.view.sideMenu.label"><input type="checkbox" id="web.view.sideMenu" name="side" checked?={ p.view.Side }/>{ p.words.Of("web.sideMenu") }<kbd id="web.view.sideMenu.shortcut">Alt+1</kbd></label>
			<input type="hidden" id="web.view.width" name="width" value={ strconv.Itoa(p.view.Width) }/>
			<input type="hidden" id="web.view.detailsWidth" name="details" value={ strconv.Itoa(p.view.DetailsWidth) }/>
		</form>
	</div>
}

// tabs are the open tabs, the front one marked.
templ tabs(p page, outOfBand bool) {
	<div id="web.tabs" class="tabs" role="tablist" { swapOutOfBand(outOfBand)... }>
		for _, item := range p.openTabs() {
			<div id={ "web.tab." + item.name } class="tab" role="tab" aria-selected={ strconv.FormatBool(item.name == p.view.Active) }>
				<button id={ "web.tab." + item.name + ".title" } class="tab-title" type="button" hx-get={ "/tab/" + item.name } hx-target="[id='web.content']">{ p.words.Of(item.title) }</button>
				<button id={ "web.tab." + item.name + ".close" } class="close" type="button" hx-delete={ "/tab/" + item.name } hx-target="[id='web.content']" aria-label={ p.words.Of("web.close") } { p.closeTip(item.name)... }>✕</button>
			</div>
		}
	</div>
}

// dragLine is a line between two of the shell's parts that a person drags to widen or narrow one, as the approved base design has it: the side
// menu's and the details panel's (#161 R10, findings row 304). The part is width wide, from edge of the within box, between least and most
// pixels; the View menu keeps it in keeps once the line is let go.
templ dragLine(id, class, within, edge, width, keeps string, least, most int) {
	<div
		id={ id }
		class={ "sash", class }
		aria-hidden="true"
		data-within={ within }
		data-edge={ edge }
		data-width={ width }
		data-keeps={ keeps }
		data-least={ strconv.Itoa(least) }
		data-most={ strconv.Itoa(most) }
		hx-on:pointerdown="event.preventDefault(); this.setPointerCapture(event.pointerId); this.closest('.shell').classList.add('resizing')"
		hx-on:pointermove={ templ.JSUnsafeFuncCall(lineDragged) }
		hx-on:lostpointercapture="this.closest('.shell').classList.remove('resizing'); htmx.trigger(document.getElementById('web.viewMenu'), 'change')"
	></div>
}

// detailsPanel is the details panel beside a list, like Google Drive's (the base design): empty, so hidden, until a row fills it. A tab's
// answer carries it empty beside its content, out of band, so a panel never outlives its list.
templ detailsPanel(outOfBand bool) {
	<aside id="web.details" class="details" aria-live="polite" { swapOutOfBand(outOfBand)... }>
		{ children... }
	</aside>
}

// statusBar is the host this page came from at its start and, for whoever is signed in, My account at its end: their name with an arrow, so it
// reads as a menu, opening above it on who is signed in, Shared settings and My history, then Sign out apart (#161 R2; the owner, 23 Nov 2026,
// findings rows 306, 313, 315). The version is the sign-in form's and Settings', as the app shows it. The View menu hides it, My account with it,
// until it is ticked again (findings row 320).
templ statusBar(p page) {
	<footer id="web.statusBar" class="status">
		<span id="web.host" class="host"><span id="web.host.dot" class="dot" aria-hidden="true"></span>{ p.host }</span>
		if p.person != "" {
			<button id="web.account" class="account" type="button" popovertarget="web.accountMenu" aria-haspopup="menu">
				<span id="web.account.name">{ p.person }</span>
				<span id="web.account.arrow" class="arrow" aria-hidden="true">{ arrow }</span>
			</button>
			<div id="web.accountMenu" class="menu-pop account-menu" popover>
				<div id="web.accountMenu.who" class="account-who">
					<b id="web.accountMenu.name">{ p.person }</b>
					if p.caller.Username != "" {
						<small id="web.accountMenu.username" class="hint">{ p.caller.Username }</small>
					}
				</div>
				<button id="web.sharedSettings" class="choice" type="button" hx-get="/tab/settings" hx-target="[id='web.content']" hx-on:click="document.getElementById('web.accountMenu').hidePopover()">{ p.words.Of("sharedSettings.title") }</button>
				<button id="web.myHistory" class="choice" type="button" hx-get="/tab/myHistory" hx-target="[id='web.content']" hx-on:click="document.getElementById('web.accountMenu').hidePopover()">{ p.words.Of("history.myTitle") }</button>
				<hr class="menu-line"/>
				<button id="myAccount.signOut" class="choice sign-out" type="button" hx-post="/sign-out" hx-target="[id='web.shell']" hx-swap="outerHTML">{ p.words.Of("myAccount.signOut") }</button>
			</div>
		}
	</footer>
}

// emptyContent is the content area before a tab is open.
templ emptyContent(p page) {
	<p id="web.pickFromMenu" class="empty">{ p.words.Of("web.pickFromMenu") }</p>
}

// signInForm is the sign-in, in the content area: what the app's sign-in has, with the language and the version at its foot, since Settings cannot
// be reached before signing in (#161 R2, R12, R19; findings row 315). The cursor waits in Username, or in Password when a refusal kept the
// username (#76 row 286). message is the word key of a refusal, or ""; p.notice says what just happened, as after a reset.
templ signInForm(p page, message string, username string) {
	<div class="signin">
		<form
			id="signIn.form"
			hx-post="/sign-in"
			hx-target="closest .signin"
			hx-swap="outerHTML"
			data-no-connection={ p.words.Of("signIn.noConnection") }
			hx-on::send-error="const message = this.querySelector('.refusal'); message.textContent = this.dataset.noConnection; message.hidden = false"
		>
			<h1 id="signIn.title">{ p.words.Of("app.title") }</h1>
			<p id="signIn.hint" class="hint">{ p.words.Of("signIn.hint") }</p>
			<p id="signIn.notice" class="notice" role="status" hidden?={ p.notice == "" }>{ p.words.Of(p.notice) }</p>
			<div class="field">
				<label id="signIn.username.label" for="signIn.username">{ p.words.Of("signIn.username") }</label>
				<input id="signIn.username" name="username" autocomplete="username" autofocus?={ username == "" } required value={ username }/>
			</div>
			<div class="field">
				<label id="signIn.password.label" for="signIn.password">{ p.words.Of("signIn.password") }</label>
				<input id="signIn.password" name="password" type="password" autocomplete="current-password" autofocus?={ username != "" } required/>
			</div>
			<p id="signIn.message" class="refusal" role="alert" hidden?={ message == "" }>{ p.words.Of(message) }</p>
			<button id="signIn.submit" class="primary" type="submit">{ p.words.Of("signIn.submit") }</button>
			<div class="form-links">
				<a id="signIn.registerProject" href="#" hx-get="/register" hx-target="closest .signin" hx-swap="outerHTML">{ p.words.Of("signIn.registerProject") }</a>
				<a id="auth.forgotPassword" href="#" hx-get="/forgot-password" hx-target="closest .signin" hx-swap="outerHTML">{ p.words.Of("auth.forgotPassword") }</a>
			</div>
			<div class="form-language">
				@languageChoice(p)
			</div>
			<p id="appVersion.line" class="hint form-version">{ p.words.Of("app.version") + " " + Version }<bdi>{ build }</bdi></p>
		</form>
	</div>
}

// forgotPasswordForm is Forgot password, in the sign-in's place (UC-002, AC-02.6): the username or email and Send, then, once a code is sent,
// the code and the new password twice, as the app's screen has them. Two forms in one box, so Enter in the login sends and Enter below resets;
// the reset carries the login the code was sent for. message is the word key of a refusal, or "".
templ forgotPasswordForm(p page, message string, login string, sent bool) {
	<div class="signin">
		<div
			data-no-connection={ p.words.Of("auth.noConnection") }
			hx-on::send-error="const message = this.querySelector('.refusal'); message.textContent = this.dataset.noConnection; message.hidden = false"
		>
			<h1 id="forgotPassword.title">{ p.words.Of("auth.forgotPassword") }</h1>
			<p id="forgotPassword.message" class="refusal" role="alert" hidden?={ message == "" }>{ p.words.Of(message) }</p>
			<form id="forgotPassword.sendForm" hx-post="/forgot-password" hx-target="closest .signin" hx-swap="outerHTML">
				<div class="field">
					<label id="forgotPassword.login.label" for="forgotPassword.login">{ p.words.Of("auth.loginOrEmail") }</label>
					<input id="forgotPassword.login" name="login" autocomplete="username" autofocus?={ !sent } required value={ login }/>
				</div>
				if sent {
					<input type="hidden" name="sent" value="true"/>
				}
				<button id="forgotPassword.send" class="secondary" type="submit">{ p.words.Of("auth.sendCode") }</button>
			</form>
			if sent {
				<p id="forgotPassword.sent" class="notice" role="status">{ p.words.Of("auth.codeSent") }</p>
				<form id="forgotPassword.form" hx-post="/reset-with-code" hx-target="closest .signin" hx-swap="outerHTML">
					<input id="forgotPassword.codeLogin" type="text" name="login" autocomplete="username" value={ login } hidden/>
					<div class="field">
						<label id="forgotPassword.code.label" for="forgotPassword.code">{ p.words.Of("auth.code") }</label>
						<input id="forgotPassword.code" name="code" inputmode="numeric" autocomplete="one-time-code" autofocus required/>
					</div>
					<div class="field">
						<label id="forgotPassword.new.label" for="forgotPassword.new">{ p.words.Of("changePassword.new") }</label>
						<input id="forgotPassword.new" name="new" type="password" autocomplete="new-password" required/>
					</div>
					<div class="field">
						<label id="forgotPassword.confirm.label" for="forgotPassword.confirm">{ p.words.Of("changePassword.confirm") }</label>
						<input id="forgotPassword.confirm" name="confirm" type="password" autocomplete="new-password" required/>
					</div>
					<button id="forgotPassword.reset" class="primary" type="submit">{ p.words.Of("auth.resetWithCode") }</button>
				</form>
			}
			<div class="form-links">
				<a id="forgotPassword.cancel" href="#" hx-get="/sign-in" hx-target="closest .signin" hx-swap="outerHTML">{ p.words.Of("common.cancel") }</a>
			</div>
		</div>
	</div>
}

// changePasswordForm replaces a temporary password before anything else (AC-02.1, #161 R13), in the content area; the hidden username tells a
// password manager whose password it is (R19). message is the word key of a refusal, or "".
templ changePasswordForm(p page, message string, username string) {
	<div class="signin">
		<form
			id="changePassword.form"
			hx-post="/change-password"
			hx-target="closest .signin"
			hx-swap="outerHTML"
			data-no-connection={ p.words.Of("changePassword.noConnection") }
			hx-on::send-error="const message = this.querySelector('.refusal'); message.textContent = this.dataset.noConnection; message.hidden = false"
		>
			<h1 id="changePassword.title">{ p.words.Of("changePassword.title") }</h1>
			<p id="changePassword.hint" class="hint">{ p.words.Of("changePassword.hint") }</p>
			<input id="changePassword.username" type="text" name="username" autocomplete="username" value={ username } hidden/>
			<div class="field">
				<label id="changePassword.current.label" for="changePassword.current">{ p.words.Of("changePassword.current") }</label>
				<input id="changePassword.current" name="current" type="password" autocomplete="current-password" autofocus required/>
			</div>
			<div class="field">
				<label id="changePassword.new.label" for="changePassword.new">{ p.words.Of("changePassword.new") }</label>
				<input id="changePassword.new" name="new" type="password" autocomplete="new-password" required/>
			</div>
			<div class="field">
				<label id="changePassword.confirm.label" for="changePassword.confirm">{ p.words.Of("changePassword.confirm") }</label>
				<input id="changePassword.confirm" name="confirm" type="password" autocomplete="new-password" required/>
			</div>
			<p id="changePassword.message" class="refusal" role="alert" hidden?={ message == "" }>{ p.words.Of(message) }</p>
			<button id="changePassword.submit" class="primary" type="submit">{ p.words.Of("changePassword.submit") }</button>
		</form>
	</div>
}

// languageChoice is the two languages, the one in use marked; choosing one draws the page again in it (#161 S6).
templ languageChoice(p page) {
	<nav id="web.language" class="language" aria-label={ p.words.Of("myAccount.language") }>
		<a id="myAccount.arabic" href="/language/ar" lang="ar" aria-current={ strconv.FormatBool(p.language == "ar") }>{ p.words.Of("myAccount.arabic") }</a>
		<a id="myAccount.english" href="/language/en" lang="en" aria-current={ strconv.FormatBool(p.language == "en") }>{ p.words.Of("myAccount.english") }</a>
	</nav>
}
