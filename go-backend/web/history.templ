package web

import "strconv"

// historyPerson is a history's choice of the person whose lines it keeps, every one's when none is chosen, as the app's history screens offer it.
templ historyPerson(p page, shown history) {
	<label id={ shown.name + ".personChoice.label" } class="pick-select">
		{ p.words.Of("history.person") }
		<select id={ shown.name + ".personChoice" } name="by">
			<option id={ shown.name + ".personChoice.option.none" } value="">{ p.words.Of("history.all") }</option>
			for _, member := range shown.members {
				<option id={ shown.name + ".person." + member.ID.String() } value={ member.ID.String() } selected?={ member.ID.String() == shown.query.Get("by") }>{ member.DisplayName }</option>
			}
		</select>
	</label>
}

// historyList is a history's lines, newest first, with Show more while a page was full; or that there is nothing yet.
templ historyList(p page, shown history) {
	if len(shown.rows) == 0 {
		<p id={ shown.name + ".empty" } class="empty">{ p.words.Of("history.empty") }</p>
	} else {
		<div class="grid-wrap">
			<table id={ shown.name + ".table" } class="grid lines">
				<tbody id={ shown.name + ".lines" }>
					@historyRows(shown)
				</tbody>
			</table>
		</div>
		@historyMoreButton(p, shown, false)
	}
}

// historyRows are a page's lines of a history: what was done, marked by its kind, and who did it when.
templ historyRows(shown history) {
	for _, row := range shown.rows {
		<tr id={ shown.name + ".line." + strconv.FormatInt(row.id, 10) }>
			<td id={ shown.name + ".what." + strconv.FormatInt(row.id, 10) } class={ "decision", row.kind }>{ row.what }</td>
			<td id={ shown.name + ".who." + strconv.FormatInt(row.id, 10) } class="who">{ row.who }</td>
		</tr>
	}
}

// historyMoreButton is Show more under a history while a page was full, adding the next one after the last line; carried out of band beside
// that page, it is gone once there is no more.
templ historyMoreButton(p page, shown history, outOfBand bool) {
	if shown.more() != "" {
		<button id={ shown.name + ".more" } class="quiet-button more" type="button" hx-get={ shown.more() } hx-target={ "[id='" + shown.name + ".lines']" } hx-swap="beforeend" { swapOutOfBand(outOfBand)... }>{ p.words.Of("history.more") }</button>
	} else if outOfBand {
		<button id={ shown.name + ".more" } hx-swap-oob="delete"></button>
	}
}

// historyKind is a history's choice of the kind of line it keeps, every kind when none is chosen, as the app's history screens offer it.
templ historyKind(p page, shown history, kinds []string) {
	<label id={ shown.name + ".kindChoice.label" } class="pick-select">
		{ p.words.Of("history.kind") }
		<select id={ shown.name + ".kindChoice" } name="area">
			<option id={ shown.name + ".all" } value="">{ p.words.Of("history.all") }</option>
			for _, kind := range kinds {
				<option id={ shown.name + ".kind." + kind } value={ kind } selected?={ kind == shown.query.Get("area") }>{ p.words.Of("history.area." + kind) }</option>
			}
		</select>
	</label>
}

// projectHistoryPage is «سجل المشروع» as the app's screen shows it: a search, the kind and the person to narrow by, then each line, newest first.
templ projectHistoryPage(p page, shown history) {
	<div class="view-head">
		<h2 id="projectHistory.title">{ p.words.Of("history.projectTitle") }</h2>
		<span id="projectHistory.actions" class="head-actions">
			@searchToggle(p, "projectHistory.searchToggle", "/tab/projectHistory")
		</span>
	</div>
	if p.searching {
		<form id="projectHistory.filters" class="filters" hx-get="/tab/projectHistory" hx-target="[id='web.content']" hx-trigger="change, input changed delay:400ms from:[name='text'], submit">
			<input id="projectHistory.searchOn" type="hidden" name="search" value="on"/>
			<input id="projectHistory.search" class="search" autofocus?={ p.searchOpened } type="search" name="text" placeholder={ p.words.Of("common.searchIn", p.words.Of("history.projectTitle")) } aria-label={ p.words.Of("common.searchIn", p.words.Of("history.projectTitle")) } value={ shown.query.Get("text") }/>
			@historyKind(p, shown, projectAreas)
			@historyPerson(p, shown)
		</form>
	}
	@historyList(p, shown)
}

// myHistoryPage is «سجلي» as the app's screen shows it: a search and the kind to narrow by, then each line of the person's own login.
templ myHistoryPage(p page, shown history) {
	<div class="view-head">
		<h2 id="myHistory.title">{ p.words.Of("history.myTitle") }</h2>
		<span id="myHistory.person" class="hint">{ p.person }</span>
		<span id="myHistory.actions" class="head-actions">
			@searchToggle(p, "myHistory.searchToggle", "/tab/myHistory")
		</span>
	</div>
	if p.searching {
		<form id="myHistory.filters" class="filters" hx-get="/tab/myHistory" hx-target="[id='web.content']" hx-trigger="change, input changed delay:400ms from:[name='text'], submit">
			<input id="myHistory.searchOn" type="hidden" name="search" value="on"/>
			<input id="myHistory.search" class="search" autofocus?={ p.searchOpened } type="search" name="text" placeholder={ p.words.Of("common.searchIn", p.words.Of("history.myTitle")) } aria-label={ p.words.Of("common.searchIn", p.words.Of("history.myTitle")) } value={ shown.query.Get("text") }/>
			@historyKind(p, shown, loginAreas)
		</form>
	}
	@historyList(p, shown)
}
