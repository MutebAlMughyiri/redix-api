package web

import (
	"net/url"
	"strconv"
	"time"

	"github.com/google/uuid"

	"github.com/MutebAlMughyiri/redix-api/go-backend/internal/access"
	"github.com/MutebAlMughyiri/redix-api/go-backend/internal/entries"
	"github.com/MutebAlMughyiri/redix-api/go-backend/internal/statement"
)

// entriesList is the Entries tab (UC-028, redix-api #166): the app's filters as one row - search, mine, kinds, statuses, the period and a number -
// each change asking the list again; the entries a page at a time with Show more. Add entry stands gray until it is built.
templ entriesList(p page, query url.Values, rows []entries.Row, more bool, take int) {
	<div class="view-head">
		<h2 id="entries.title">{ p.words.Of("entries.title") }</h2>
		<span id="entries.actions" class="head-actions">
			@searchToggle(p, "entries.searchToggle", "/tab/entries")
			<button
				id="entries.new"
				class="primary small"
				type="button"
				disabled?={ !p.mayEnterExpenses() }
				title={ p.words.Of("permissions.recordEntries") }
				hx-get="/tab/addEntry"
				hx-target="[id='web.content']"
			>{ p.words.Of("entries.new") }</button>
		</span>
	</div>
	if p.searching {
		<form id="entries.filters" class="filters" hx-get="/tab/entries" hx-target="[id='web.content']" hx-trigger={ filtersTrigger }>
			<input id="entries.searchOn" type="hidden" name="search" value="on"/>
			<input id="entries.search" class="search" autofocus?={ p.searchOpened } type="search" name="text" placeholder={ p.words.Of("entries.searchHint") } aria-label={ p.words.Of("entries.searchHint") } value={ query.Get("text") }/>
			@filterButton(p, kindFilter(p, query))
			@filterButton(p, statusFilter(p, query))
			@filterHead(p, "entries.period", "entries.period", periodSummary(p, query.Get("from"), query.Get("to")))
			<div id="entries.period.list" class="filter-list" popover style={ templ.SafeCSS(anchored("position-anchor", "entries.period")) }>
				<label id="entries.from.label" class="date-choice">{ p.words.Of("filters.from") }<input id="entries.from" type="date" name="from" value={ query.Get("from") }/></label>
				<label id="entries.to.label" class="date-choice">{ p.words.Of("filters.to") }<input id="entries.to" type="date" name="to" value={ query.Get("to") }/></label>
			</div>
			<label id="entries.mine" class="filter-button toggle-filter"><input id="entries.mine.input" type="checkbox" name="mine" value="true" checked?={ query.Get("mine") == "true" } data-applies/>{ p.words.Of("entries.mine") }</label>
			<input id="entries.number" class="number" type="number" name="number" min="1" placeholder={ p.words.Of("entries.number") } aria-label={ p.words.Of("entries.number") } value={ query.Get("number") } data-applies/>
			if narrows(query) {
				<a id="entries.clear" class="clear-all" href="#" hx-get="/tab/entries?search=on" hx-target="[id='web.content']">{ p.words.Of("entries.clearFilters") }</a>
			}
		</form>
	}
	if len(rows) == 0 {
		<p id="entries.empty" class="empty">{ p.words.Of("entries.empty") }</p>
	} else {
		@entryRows(p, rows)
	}
	if more {
		<button
			id="entries.more"
			class="quiet-button more"
			type="button"
			hx-get="/tab/entries"
			hx-include="[id='entries.filters']"
			hx-vals={ takeMore(take) }
			hx-target="[id='web.content']"
		>{ p.words.Of("entries.showMore") }</button>
	}
}

// entryPanel is an entry in the details panel: its number and status, why it was rejected, and what the lists know of it, as the app's read-only
// entry shows it, with what the caller may do to it - Approve one that waits, gray without the permission; Send a draft; Remove, asked first;
// Change, gray until Add entry is built - and what shown says (redix-api #166); ✕ and Esc hide it.
templ entryPanel(p page, row entries.Row, shown said) {
	<div class="details-head">
		<h3 id="entry.title">{ p.words.Of("entries.numberOf", strconv.FormatInt(row.Number, 10)) }</h3>
		<button id="entry.close" class="x" type="button" aria-label={ p.words.Of("web.close") } hx-on:click={ templ.JSUnsafeFuncCall(closeDetails) }>✕</button>
	</div>
	<dl class="facts">
		<dt id="entry.status.label">{ p.words.Of("entries.status") }</dt>
		<dd id="entry.status"><span id="entry.status.chip" class={ "state", row.Status.Name() }>{ p.words.Of("entries." + row.Status.Name()) }</span></dd>
		if row.RejectionReason != "" {
			<dt id="entry.reason.label">{ p.words.Of("entries.reason") }</dt>
			<dd id="entry.reason" class="refused">{ row.RejectionReason }</dd>
		}
		<dt id="entry.date.label">{ p.words.Of("expenses.date") }</dt>
		<dd id="entry.date">{ row.EntryDate.Format(time.DateOnly) }</dd>
		<dt id="entry.item.label">{ p.words.Of("contracts.item") }</dt>
		<dd id="entry.item">{ entryTitle(row) }</dd>
		if row.SupplierName != "" {
			<dt id="entry.supplier.label">{ p.words.Of("expenses.supplier") }</dt>
			<dd id="entry.supplier">{ row.SupplierName }</dd>
		}
		if row.InvoiceNumber != "" {
			<dt id="entry.invoice.label">{ p.words.Of("entries.fileInvoice") }</dt>
			<dd id="entry.invoice">{ row.InvoiceNumber }</dd>
		}
		for at, file := range row.Files {
			<dt id={ "entry.file." + strconv.Itoa(at) + ".label" }>{ p.words.Of(fileWord(file.Role)) }</dt>
			<dd id={ "entry.file." + strconv.Itoa(at) + ".value" }>
				@keptFile("entry.file."+strconv.Itoa(at), file.AttachmentID.String(), file.Name, file.ContentType)
			</dd>
		}
		<dt id="entry.amount.label">{ p.words.Of("expenses.amount") }</dt>
		<dd id="entry.amount" class="money">{ statement.Money(row.Amount) }</dd>
		if row.PaymentMethodName != "" {
			<dt id="entry.paymentMethod.label">{ p.words.Of("expenses.paymentMethod") }</dt>
			<dd id="entry.paymentMethod">{ row.PaymentMethodName }</dd>
		}
		<dt id="entry.account.label">{ p.words.Of("expenses.account") }</dt>
		<dd id="entry.account">{ row.AccountName }</dd>
		if row.Description != "" {
			<dt id="entry.description.label">{ p.words.Of("expenses.description") }</dt>
			<dd id="entry.description">{ row.Description }</dd>
		}
	</dl>
	<p id="entry.enteredBy" class="hint details-foot">{ p.words.Of("entries.enteredBy", row.AuthorName) }</p>
	if shown.notice != "" {
		<p id="entry.notice" class="notice details-say" role="status">{ p.words.Of(shown.notice) }</p>
	}
	if shown.refusal != "" {
		<p id="entry.refusal" class="refusal details-say" role="alert">{ p.words.Of(shown.refusal) }</p>
	}
	if shown.asking == "reject" && row.Status.Name() == "pendingApproval" && !p.finished() && p.may(access.ApproveEntries) {
		@rejectForm(p, row)
	} else if shown.asking == "remove" && p.mayRemove(row) {
		<div id="entry.ask" class="details-say ask">
			<span id="entry.askQuestion">
				if row.Status.Name() == "approved" {
					{ p.words.Of("entries.removeQuestion") }
				} else {
					{ p.words.Of("swipe.question") }
				}
			</span>
			<button id="entry.removeConfirm" class="primary small danger" type="button" hx-post={ "/entry/" + row.ID.String() + "/remove" } hx-target="[id='web.details']">{ p.words.Of("swipe.remove") }</button>
			<button id="entry.removeCancel" class="quiet-button" type="button" hx-get={ "/details/entry/" + row.ID.String() } hx-target="[id='web.details']">{ p.words.Of("common.cancel") }</button>
		</div>
	} else {
		<div class="details-actions">
			if row.Status.Name() == "pendingApproval" {
				<button
					id="entry.approve"
					class="primary small"
					type="button"
					disabled?={ p.finished() || !p.may(access.ApproveEntries) }
					title={ p.words.Of("permissions.approveEntries") }
					hx-post={ "/entry/" + row.ID.String() + "/approve" }
					hx-target="[id='web.details']"
				>{ p.words.Of("approvals.approve") }</button>
				<button
					id="entry.reject"
					class="quiet-button"
					type="button"
					disabled?={ p.finished() || !p.may(access.ApproveEntries) }
					title={ p.words.Of("permissions.approveEntries") }
					hx-get={ "/details/entry/" + row.ID.String() + "?asking=reject" }
					hx-target="[id='web.details']"
				>{ p.words.Of("approvals.reject") }</button>
			}
			if row.Status.Name() == "draft" && p.mayChange(row) {
				<button id="entry.send" class="primary small" type="button" hx-post={ "/entry/" + row.ID.String() + "/send" } hx-target="[id='web.details']">{ p.words.Of("entries.send") }</button>
			}
			if p.mayChange(row) {
				<button id="entry.change" class="quiet-button" type="button" hx-get={ "/tab/changeEntry?entry=" + row.ID.String() } hx-target="[id='web.content']">
					if row.Status.Name() == "rejected" {
						{ p.words.Of("entries.fix") }
					} else {
						{ p.words.Of("entries.edit") }
					}
				</button>
			}
			if p.mayRemove(row) {
				<button id="entry.remove" class="quiet-button" type="button" hx-get={ "/details/entry/" + row.ID.String() + "?asking=remove" } hx-target="[id='web.details']">{ p.words.Of("entries.remove") }</button>
			}
		</div>
	}
}

// entryGone is the details panel once its entry has left the list - removed - saying so, its row leaving the list too, sent in a template as
// rowBeside's is.
templ entryGone(p page, entryID uuid.UUID, shown said) {
	<div class="details-head">
		<h3 id="entry.title">{ p.words.Of(shown.notice) }</h3>
		<button id="entry.close" class="x" type="button" aria-label={ p.words.Of("web.close") } hx-on:click={ templ.JSUnsafeFuncCall(closeDetails) }>✕</button>
	</div>
	<template><tr id={ p.rowID(entryID) } hx-swap-oob="delete"></tr></template>
}

// rejectForm is Reject's reason in the details panel, as the app's reason sheet asks it: its four quick reasons, a reason typed - which goes to
// who entered the entry, to fix and send again - and Reject.
templ rejectForm(p page, row entries.Row) {
	<form id="reasonSheet.form" class="details-say ask reason" hx-post={ "/entry/" + row.ID.String() + "/reject" } hx-target="[id='web.details']">
		<span id="reasonSheet.title">{ p.words.Of("approvals.rejectTitle") }</span>
		<fieldset id="reasonSheet.quickReasons" class="picks">
			<legend id="reasonSheet.quickReasonHeading">{ p.words.Of("approvals.quickReason") }</legend>
			for at, reason := range quickReasons {
				<label id={ "reasonSheet.quickReason." + strconv.Itoa(at) } class="pick"><input id={ "reasonSheet.quickReason." + strconv.Itoa(at) + ".input" } type="radio" name="quick" value={ p.words.Of(reason) }/>{ p.words.Of(reason) }</label>
			}
		</fieldset>
		<textarea id="reasonSheet.reason" name="reason" maxlength="500" aria-label={ p.words.Of("approvals.reason") } placeholder={ p.words.Of("approvals.reason") }></textarea>
		<small id="reasonSheet.about" class="hint">{ p.words.Of("approvals.reasonHint") }</small>
		<span id="reasonSheet.actions" class="details-actions">
			<button id="reasonSheet.send" class="primary small danger" type="submit">{ p.words.Of("approvals.rejectSend") }</button>
			<button id="entry.rejectCancel" class="quiet-button" type="button" hx-get={ "/details/entry/" + row.ID.String() } hx-target="[id='web.details']">{ p.words.Of("common.cancel") }</button>
		</span>
	</form>
}

// rowBeside is an entry's row carried beside the panel, out of band, in a template: a row outside a table is dropped by the browser's parser,
// and htmx swaps what a template holds.
templ rowBeside(p page, row entries.Row) {
	<template>
		if p.view.Active != "approvals" {
			@entryRow(p, row, true)
		} else if row.Status.Name() != "pendingApproval" {
			<tr id={ p.rowID(row.ID) } hx-swap-oob="delete"></tr>
		}
	</template>
}
