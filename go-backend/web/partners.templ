package web

import (
	"strconv"
	"time"

	"github.com/google/uuid"

	"github.com/MutebAlMughyiri/redix-api/go-backend/internal/db/store"
	"github.com/MutebAlMughyiri/redix-api/go-backend/internal/partners"
	"github.com/MutebAlMughyiri/redix-api/go-backend/internal/statement"
)

// partnersList is Partners as the app's screen shows them (UC-016, UC-040): the capital total on its card, then each partner the caller sees -
// their name, their login or that they have none, their share and their balance.
templ partnersList(p page, shown partnersShown) {
	<div class="view-head">
		<h2 id="partners.title">{ p.words.Of("partners.title") }</h2>
		<span id="partners.actions" class="head-actions">
			<button
				id="partners.add"
				class="primary small"
				type="button"
				disabled?={ !p.mayKeepPartners() }
				title={ p.words.Of("permissions.manageSettings") }
				hx-get="/details/partner/new"
				hx-target="[id='web.details']"
			>{ p.words.Of("partners.new") }</button>
			<button id="partners.history" class="quiet-button" type="button" hx-get="/tab/partnerHistory" hx-target="[id='web.content']">{ p.words.Of("partners.history") }</button>
		</span>
	</div>
	<section id="partners.total.card" class="card">
		<dl class="facts">
			<dt id="partners.total.label">{ p.words.Of("capital.total") }</dt>
			<dd id="partners.total" class="money">{ statement.Money(shown.total.Number()) }</dd>
		</dl>
	</section>
	if len(shown.lines) == 0 {
		<p id="partners.empty" class="empty">{ p.words.Of("partners.empty") }</p>
	} else {
		<div class="grid-wrap">
			<table id="partners.table" class="grid" hx-on:keydown={ templ.JSUnsafeFuncCall(listKeys) } hx-on:click={ templ.JSUnsafeFuncCall(listSelects) }>
				<tbody id="partners.rows">
					for _, line := range shown.lines {
						<tr
							id={ "partners.row." + line.ID.String() }
							tabindex="0"
							aria-selected="false"
							hx-get={ "/details/partner/" + line.ID.String() }
							hx-target="[id='web.details']"
						>
							<td id={ "partners.partner." + line.ID.String() }>
								<span id={ "partners.name." + line.ID.String() }>{ line.Name }</span>
								<small id={ "partners.details." + line.ID.String() } class="hint">
									if shown.login(line.ID) != "" {
										{ shown.login(line.ID) }
									} else {
										{ p.words.Of("partners.noLogin") }
									}
								</small>
							</td>
							<td id={ "partners.share." + line.ID.String() }>{ shareOf(line.SharePercent) }</td>
							<td id={ "partners.balance." + line.ID.String() } class="amount">{ statement.Money(line.Balance.Number()) }</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}

// partnerPanel is a partner in the details panel: their balance and share on one line, as the app's row shows them, and their approved
// movements, newest first, each with its kind, date, account and amount, and its receipt handed over, as the app's movements screen lists them
// (#175 D3).
templ partnerPanel(p page, shown partnersShown, line partners.CapitalLine, movements []partners.Movement, said said) {
	<div class="details-head">
		<h3 id="partner.title">{ line.Name }</h3>
		<button id="partner.close" class="x" type="button" aria-label={ p.words.Of("web.close") } hx-on:click="document.getElementById('web.details').replaceChildren()">✕</button>
	</div>
	<p id="partner.figures" class="details-say"><b id="partner.balance" class="money">{ statement.Money(line.Balance.Number()) }</b> · <span id="partner.share">{ shareOf(line.SharePercent) }</span></p>
	if said.refusal != "" {
		<p id="partner.refusal" class="refusal details-say" role="alert">{ p.words.Of(said.refusal) }</p>
	}
	if partner, found := shown.partnerOf(line.ID); found && p.mayKeepPartners() {
		@partnerActions(p, partner, said.asking == "delete")
	}
	<p id="partner.movements.label" class="section-title details-say">{ p.words.Of("capital.movements") }</p>
	if len(movements) == 0 {
		<p id="partner.noMovements" class="hint details-say">{ p.words.Of("capital.noMovements") }</p>
	} else {
		<ul id="partner.movements" class="movements">
			for _, movement := range movements {
				<li id={ "movements.row." + movement.ID.String() }>
					<span id={ "movements.row." + movement.ID.String() + ".title" }>
						if movement.Description != "" {
							{ movement.Description }
						} else {
							{ movement.MovementName }
						}
					</span>
					<small id={ "movements.row." + movement.ID.String() + ".subtitle" } class="hint">{ parts(movement.MovementName, movement.Date.Format(time.DateOnly), movement.AccountName) }</small>
					<b id={ "movements.row." + movement.ID.String() + ".trailing" } class="money">{ statement.Money(movement.Amount.Number()) }</b>
					if movement.AttachmentID != "" {
						@keptFile("movements.row."+movement.ID.String()+".receipt", movement.AttachmentID, movement.FileName, movement.ContentType)
					}
				</li>
			}
		</ul>
	}
}

// partnerActions are what whoever manages the settings may do to a partner in the panel: Edit, and Delete - asked first, saying their movements
// stay and which of the caller's drafts go with them; gray with its reason while the partner holds capital or waits, others' drafts named.
templ partnerActions(p page, partner partners.View, asking bool) {
	if asking && partner.MayDelete {
		<div id="partner.ask" class="details-say ask">
			<span id="partner.askQuestion">{ p.words.Of("partners.deleteQuestion") + " " + p.words.Of("partners.deleteKeepsMovements") }</span>
			if len(partner.MyDrafts) > 0 {
				<small id="partner.askDrafts">{ p.words.Of("partners.deleteRemovesMyDrafts") }</small>
			}
			<button id="partner.deleteConfirm" class="primary small danger" type="button" hx-post={ "/partner/" + partner.ID.String() + "/delete" } hx-target="[id='web.details']">{ p.words.Of("partners.delete") }</button>
			<button id="partner.deleteCancel" class="quiet-button" type="button" hx-get={ "/details/partner/" + partner.ID.String() } hx-target="[id='web.details']">{ p.words.Of("common.cancel") }</button>
		</div>
	} else {
		<div id="partner.actions" class="details-actions">
			<button id="partners.edit" class="quiet-button" type="button" hx-get={ "/details/partner/" + partner.ID.String() + "?asking=edit" } hx-target="[id='web.details']">{ p.words.Of("partners.edit") }</button>
			<button
				id="partners.delete"
				class="quiet-button"
				type="button"
				disabled?={ !partner.MayDelete }
				hx-get={ "/details/partner/" + partner.ID.String() + "?asking=delete" }
				hx-target="[id='web.details']"
			>{ p.words.Of("partners.delete") }</button>
		</div>
		if !partner.MayDelete {
			<p id="partners.deleteReason" class="hint details-say">{ p.words.Of("partners.partnerNotDeletable") }</p>
		}
		for at, author := range partner.OthersDrafts {
			<p id={ "partners.draftsBy." + strconv.Itoa(at) } class="hint details-say">{ p.words.Of("partners.draftsBy", author) }</p>
		}
	}
}

// partnerForm is New partner or Edit in the details panel, as the app's partner dialog asks it: the name, and their own login among the
// project's members - none for a partner without one -, with its hint; and why it could not be kept.
templ partnerForm(p page, editing partners.View, name string, login uuid.UUID, members []store.MembersRow, refusal string) {
	<div class="details-head">
		<h3 id="partner.title">
			if editing.ID == uuid.Nil {
				{ p.words.Of("partners.new") }
			} else {
				{ p.words.Of("partners.edit") }
			}
		</h3>
		<button id="partner.close" class="x" type="button" aria-label={ p.words.Of("web.close") } hx-on:click="document.getElementById('web.details').replaceChildren()">✕</button>
	</div>
	<form
		id="partner.form"
		class="details-form"
		if editing.ID == uuid.Nil {
			hx-post="/partner"
		} else {
			hx-post={ "/partner/" + editing.ID.String() + "/edit" }
		}
		hx-target="[id='web.details']"
	>
		<div class="field">
			<label id="partners.partnerName.label" for="partners.partnerName">{ p.words.Of("partners.name") }</label>
			<input id="partners.partnerName" name="name" required value={ name } autofocus/>
		</div>
		<div class="field">
			<label id="partners.login.label" for="partners.login">{ p.words.Of("partners.login") }</label>
			<select id="partners.login" name="login">
				<option id="partners.login.option.none" value="">{ p.words.Of("partners.noLogin") }</option>
				for _, member := range members {
					<option id={ "partners.login.option." + member.ID.String() } value={ member.ID.String() } selected?={ member.ID == login }>{ member.DisplayName }</option>
				}
			</select>
			<small id="partners.loginHint" class="hint">{ p.words.Of("partners.loginHint") }</small>
		</div>
		if refusal != "" {
			<p id="partner.refusal" class="refusal" role="alert">{ p.words.Of(refusal) }</p>
		}
		<span id="partner.formActions" class="details-actions">
			<button id="partner.save" class="primary small" type="submit">{ p.words.Of("partners.save") }</button>
		</span>
	</form>
}

// partnerGone is the details panel once its partner was deleted, saying so.
templ partnerGone(p page) {
	<div class="details-head">
		<h3 id="partner.title">{ p.words.Of("partners.deleted") }</h3>
		<button id="partner.close" class="x" type="button" aria-label={ p.words.Of("web.close") } hx-on:click="document.getElementById('web.details').replaceChildren()">✕</button>
	</div>
}

// partnersBeside is Partners again, carried out of band beside the panel, once a partner was added, changed or deleted.
templ partnersBeside(p page, shown partnersShown) {
	<div id="web.content" hx-swap-oob="innerHTML">
		@partnersList(p, shown)
	</div>
}

// partnerHistoryPage is the partner history as the app's screen shows it: a search, the partner and the person to narrow by, then each line,
// newest first, with Show more while there is more.
templ partnerHistoryPage(p page, shown history, listed partnersShown) {
	<div class="view-head">
		<h2 id="partnerHistory.title">{ p.words.Of("partners.history") }</h2>
		<span id="partnerHistory.actions" class="head-actions">
			@searchToggle(p, "partnerHistory.searchToggle", "/tab/partnerHistory")
		</span>
	</div>
	if p.searching {
		<form
			id="partnerHistory.filters"
			class="filters"
			hx-get="/tab/partnerHistory"
			hx-target="[id='web.content']"
			hx-trigger="change, input changed delay:400ms from:[name='text'], submit"
		>
			<input id="partnerHistory.searchOn" type="hidden" name="search" value="on"/>
			<input id="partnerHistory.search" class="search" autofocus?={ p.searchOpened } type="search" name="text" placeholder={ p.words.Of("common.searchIn", p.words.Of("partners.history")) } aria-label={ p.words.Of("common.searchIn", p.words.Of("partners.history")) } value={ shown.query.Get("text") }/>
			<label id="partnerHistory.partnerChoice.label" class="pick-select">
				{ p.words.Of("entryShare.partner") }
				<select id="partnerHistory.partnerChoice" name="partner">
					<option id="partnerHistory.partnerChoice.option.none" value="">{ p.words.Of("history.all") }</option>
					for _, line := range listed.lines {
						<option id={ "partnerHistory.partner." + line.ID.String() } value={ line.ID.String() } selected?={ line.ID.String() == shown.query.Get("partner") }>{ line.Name }</option>
					}
				</select>
			</label>
			@historyPerson(p, shown)
		</form>
	}
	@historyList(p, shown)
}
