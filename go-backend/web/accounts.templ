package web

import (
	"time"

	"github.com/google/uuid"

	"github.com/MutebAlMughyiri/redix-api/go-backend/internal/accounts"
	"github.com/MutebAlMughyiri/redix-api/go-backend/internal/db/store"
	"github.com/MutebAlMughyiri/redix-api/go-backend/internal/statement"
)

// accountsList is Accounts as the app's screen shows them (UC-015, redix-api #168): the last count's card - the surplus the books make, the
// actual total and their difference, or that nothing was counted yet - then the accounts grouped by type, each with its line and balance.
templ accountsList(p page, shown accountsShown) {
	<div class="view-head">
		<h2 id="accounts.title">{ p.words.Of("accounts.title") }</h2>
		<span id="accounts.actions" class="head-actions">
			<button
				id="accounts.add"
				class="primary small"
				type="button"
				disabled?={ !p.mayKeepAccounts() }
				title={ p.words.Of("permissions.manageSettings") }
				hx-get="/details/account/new"
				hx-target="[id='web.details']"
			>{ p.words.Of("accounts.new") }</button>
			<button
				id="accounts.transfer"
				class="quiet-button"
				type="button"
				disabled?={ !p.mayTransfer(shown) }
				title={ p.words.Of("permissions.moveMoney") }
				hx-get="/details/transfer"
				hx-target="[id='web.details']"
			>{ p.words.Of("transfers.button") }</button>
			<button
				id="accounts.update"
				class="quiet-button"
				type="button"
				disabled?={ !p.mayCount() }
				title={ p.words.Of("permissions.moveMoney") }
				hx-get="/tab/reconcile"
				hx-target="[id='web.content']"
			>{ p.words.Of("accounts.reconcile") }</button>
			<button id="accounts.history" class="quiet-button" type="button" hx-get="/tab/accountHistory" hx-target="[id='web.content']">{ p.words.Of("accounts.history") }</button>
		</span>
	</div>
	@reconciliationCard(p, shown.latest)
	if len(shown.accounts) == 0 {
		<p id="accounts.empty" class="empty">{ p.words.Of("accounts.empty") }</p>
	} else {
		<div class="grid-wrap">
			<table id="accounts.table" class="grid" hx-on:keydown={ templ.JSUnsafeFuncCall(listKeys) } hx-on:click={ templ.JSUnsafeFuncCall(listSelects) }>
				for _, group := range accountGroups {
					if len(shown.in(group)) > 0 {
						<tbody>
							<tr class="group"><th id={ "accounts.group." + group.name } colspan="2">{ p.words.Of(group.heading) }</th></tr>
							for _, account := range shown.in(group) {
								@accountRow(p, shown, account, false)
							}
						</tbody>
					}
				}
			</table>
		</div>
	}
}

// accountRow is an account on the list: its name and line, and its balance; an action's answer carries it out of band.
templ accountRow(p page, shown accountsShown, account accounts.View, outOfBand bool) {
	<tr
		id={ "accounts.row." + account.ID.String() }
		class={ templ.KV("disabled", !account.IsActive) }
		tabindex="0"
		aria-selected="false"
		hx-get={ "/details/account/" + account.ID.String() }
		hx-target="[id='web.details']"
		{ swapOutOfBand(outOfBand)... }
	>
		<td id={ "accounts.account." + account.ID.String() }>
			<span id={ "accounts.name." + account.ID.String() }>{ account.Name }</span>
			<small id={ "accounts.details." + account.ID.String() } class="hint">{ shown.details(p, account) }</small>
		</td>
		<td id={ "accounts.balance." + account.ID.String() } class="amount">{ statement.Money(account.Balance.Number()) }</td>
	</tr>
}

// accountBeside is an account's row carried beside the panel, out of band, in a template, as rowBeside carries an entry's.
templ accountBeside(p page, shown accountsShown, account accounts.View) {
	<template>
		@accountRow(p, shown, account, true)
	</template>
}

// reconciliationCard is the last count of the accounts' actual balances as the app's card shows it: the surplus the books make, the actual
// total, their difference - explained while there is one - and when it was counted; or that nothing was counted yet.
templ reconciliationCard(p page, latest accounts.Reconciliation) {
	<section id="reconciliation.card" class="card reconciliation">
		<dl class="facts">
			<dt id="reconciliation.surplus.label">{ p.words.Of("reconciliations.surplus") }</dt>
			<dd id="reconciliation.surplus" class="money">{ statement.Money(latest.Surplus.Number()) }</dd>
			if !latest.At.IsZero() {
				<dt id="reconciliation.actualTotal.label">{ p.words.Of("reconciliations.actualTotal") }</dt>
				<dd id="reconciliation.actualTotal" class="money">{ statement.Money(latest.ActualTotal.Number()) }</dd>
				<dt id="reconciliation.difference.label">{ p.words.Of("reconciliations.difference") }</dt>
				<dd id="reconciliation.difference" class={ "money", templ.KV("refused", latest.Difference.Number() != 0) }>{ statement.Money(latest.Difference.Number()) }</dd>
			}
		</dl>
		if latest.At.IsZero() {
			<p id="reconciliation.never" class="hint">{ p.words.Of("reconciliations.never") }</p>
		} else {
			if latest.Difference.Number() != 0 {
				<p id="reconciliation.differenceExplain" class="hint">{ p.words.Of("reconciliations.differenceExplain") }</p>
			}
			<p id="reconciliation.lastUpdated" class="hint">{ p.words.Of("reconciliations.lastUpdated") + ": " + latest.At.Format(time.DateOnly) }</p>
		}
	</section>
}

// accountPanel is an account in the details panel: its type, custodian, balance and line, and what whoever manages the project's settings may
// do to it - Disable or Enable, and Delete, asked first and gray with its reason while the account is in use - and what shown says.
templ accountPanel(p page, shown accountsShown, account accounts.View, said said) {
	<div class="details-head">
		<h3 id="account.title">{ account.Name }</h3>
		<button id="account.close" class="x" type="button" aria-label={ p.words.Of("web.close") } hx-on:click="document.getElementById('web.details').replaceChildren()">✕</button>
	</div>
	<dl class="facts">
		<dt id="account.type.label">{ p.words.Of("accounts.type") }</dt>
		<dd id="account.type">{ p.words.Of(groupOf(account).word) }</dd>
		if account.CustodianName != "" {
			<dt id="account.custodian.label">{ p.words.Of("accounts.custodian") }</dt>
			<dd id="account.custodian">{ account.CustodianName }</dd>
		}
		<dt id="account.balance.label">{ p.words.Of("expenses.amount") }</dt>
		<dd id="account.balance" class="money">{ statement.Money(account.Balance.Number()) }</dd>
	</dl>
	<p id="account.details" class="hint details-foot">{ shown.details(p, account) }</p>
	if said.notice != "" {
		<p id="account.notice" class="notice details-say" role="status">{ p.words.Of(said.notice) }</p>
	}
	if said.refusal != "" {
		<p id="account.refusal" class="refusal details-say" role="alert">{ p.words.Of(said.refusal) }</p>
	}
	if said.asking == "delete" && p.mayKeepAccounts() && !account.IsUsed {
		<div id="account.ask" class="details-say ask">
			<span id="account.askQuestion">{ p.words.Of("accounts.deleteQuestion") + " " + p.words.Of("accounts.deleteCannotUndo") }</span>
			<button id="account.deleteConfirm" class="primary small danger" type="button" hx-post={ "/account/" + account.ID.String() + "/delete" } hx-target="[id='web.details']">{ p.words.Of("accounts.delete") }</button>
			<button id="account.deleteCancel" class="quiet-button" type="button" hx-get={ "/details/account/" + account.ID.String() } hx-target="[id='web.details']">{ p.words.Of("common.cancel") }</button>
		</div>
	} else if p.mayKeepAccounts() {
		<div class="details-actions">
			<button id="accounts.edit" class="quiet-button" type="button" hx-get={ "/details/account/" + account.ID.String() + "?asking=edit" } hx-target="[id='web.details']">{ p.words.Of("accounts.edit") }</button>
			if account.IsActive {
				<button id="accounts.disable" class="quiet-button" type="button" hx-post={ "/account/" + account.ID.String() + "/disable" } hx-target="[id='web.details']">{ p.words.Of("accounts.disable") }</button>
			} else {
				<button id="accounts.enable" class="quiet-button" type="button" hx-post={ "/account/" + account.ID.String() + "/enable" } hx-target="[id='web.details']">{ p.words.Of("accounts.enable") }</button>
			}
			<button
				id="accounts.delete"
				class="quiet-button"
				type="button"
				disabled?={ account.IsUsed }
				if account.IsUsed {
					title={ p.words.Of("accounts.accountInUse") }
				}
				hx-get={ "/details/account/" + account.ID.String() + "?asking=delete" }
				hx-target="[id='web.details']"
			>{ p.words.Of("accounts.delete") }</button>
		</div>
		if account.IsUsed {
			<p id="accounts.deleteReason" class="hint details-say">{ p.words.Of("accounts.accountInUse") }</p>
		}
	}
}

// accountGone is the details panel once its account was deleted, saying so, its row leaving the list too.
templ accountGone(p page, accountID uuid.UUID, said said) {
	<div class="details-head">
		<h3 id="account.title">{ p.words.Of(said.notice) }</h3>
		<button id="account.close" class="x" type="button" aria-label={ p.words.Of("web.close") } hx-on:click="document.getElementById('web.details').replaceChildren()">✕</button>
	</div>
	<template><tr id={ "accounts.row." + accountID.String() } hx-swap-oob="delete"></tr></template>
}

// listBeside is Accounts again, carried out of band beside the panel, once an account was added or changed.
templ listBeside(p page, shown accountsShown) {
	<div id="web.content" hx-swap-oob="innerHTML">
		@accountsList(p, shown)
	</div>
}

// accountForm is New account or Edit in the details panel, as the app's account dialog asks it: the name; the type, for a new one only; who
// holds it, among the project's members - a cash custody needs one -; and why it could not be kept.
templ accountForm(p page, editing accounts.View, typed accountTyped, members []store.MembersRow, refusal string) {
	<div class="details-head">
		<h3 id="account.title">
			if editing.ID == uuid.Nil {
				{ p.words.Of("accounts.new") }
			} else {
				{ p.words.Of("accounts.edit") }
			}
		</h3>
		<button id="account.close" class="x" type="button" aria-label={ p.words.Of("web.close") } hx-on:click="document.getElementById('web.details').replaceChildren()">✕</button>
	</div>
	<form
		id="account.form"
		class="details-form"
		if editing.ID == uuid.Nil {
			hx-post="/account"
		} else {
			hx-post={ "/account/" + editing.ID.String() + "/edit" }
		}
		hx-target="[id='web.details']"
	>
		<div class="field">
			<label id="accounts.accountName.label" for="accounts.accountName">{ p.words.Of("accounts.name") }</label>
			<input id="accounts.accountName" name="name" required value={ typed.name } autofocus/>
		</div>
		if editing.ID == uuid.Nil {
			<fieldset id="accounts.typeChoice" class="picks">
				<legend id="accounts.typeHeading">{ p.words.Of("accounts.type") }</legend>
				for _, group := range accountGroups {
					<label id={ "accounts.type." + group.name } class="pick"><input id={ "accounts.type." + group.name + ".input" } type="radio" name="type" value={ group.name } checked?={ typed.kind == group.name }/>{ p.words.Of(group.word) }</label>
				}
			</fieldset>
		}
		<div class="field">
			<label id="accounts.custodian.label" for="accounts.custodian">{ p.words.Of("accounts.custodian") }</label>
			<select id="accounts.custodian" name="custodian">
				<option id="accounts.custodian.option.none" value="">{ p.words.Of("accounts.noCustodian") }</option>
				for _, member := range members {
					<option id={ "accounts.custodian.option." + member.ID.String() } value={ member.ID.String() } selected?={ member.ID == typed.custodian }>{ member.DisplayName }</option>
				}
			</select>
		</div>
		if refusal != "" {
			<p id="account.refusal" class="refusal" role="alert">{ p.words.Of(refusal) }</p>
		}
		<span id="account.actions" class="details-actions">
			<button id="account.save" class="primary small" type="submit">{ p.words.Of("accounts.save") }</button>
		</span>
	</form>
}

// transferForm is Transfer in the details panel, as the app's transfer dialog asks it: from which active account - its balance now under it -,
// to which, the amount, the date and notes, and why it could not be made.
templ transferForm(p page, shown accountsShown, typed transferTyped, refusal string) {
	<div class="details-head">
		<h3 id="transfer.title">{ p.words.Of("transfers.title") }</h3>
		<button id="transfer.close" class="x" type="button" aria-label={ p.words.Of("web.close") } hx-on:click="document.getElementById('web.details').replaceChildren()">✕</button>
	</div>
	<form id="transfer.form" class="details-form" hx-post="/transfer" hx-target="[id='web.details']">
		<div class="field">
			<label id="transfer.from.label" for="transfer.from">{ p.words.Of("transfers.from") }</label>
			<select id="transfer.from" name="from" hx-get="/details/transfer" hx-include="closest form" hx-target="[id='web.details']">
				for _, account := range shown.active() {
					<option id={ "transfer.from.option." + account.ID.String() } value={ account.ID.String() } selected?={ account.ID == typed.from }>{ account.Name }</option>
				}
			</select>
			if from, found := shown.accountOf(typed.from); found {
				<small id="transfer.balanceNow" class="hint">{ p.words.Of("transfers.balanceNow", statement.Money(from.Balance.Number())) }</small>
			}
		</div>
		<div class="field">
			<label id="transfer.to.label" for="transfer.to">{ p.words.Of("transfers.to") }</label>
			<select id="transfer.to" name="to">
				for _, account := range shown.active() {
					if account.ID != typed.from {
						<option id={ "transfer.to.option." + account.ID.String() } value={ account.ID.String() } selected?={ account.ID == typed.to }>{ account.Name }</option>
					}
				}
			</select>
		</div>
		<div class="field">
			<label id="transfer.amount.label" for="transfer.amount">{ p.words.Of("transfers.amount") }</label>
			<input id="transfer.amount" name="amount" inputmode="decimal" required value={ typed.amount }/>
		</div>
		<div class="field">
			<label id="transfer.date.label" for="transfer.date">{ p.words.Of("transfers.date") }</label>
			<input id="transfer.date" name="date" type="date" required value={ typed.date }/>
		</div>
		<div class="field">
			<label id="transfer.notes.label" for="transfer.notes">{ p.words.Of("transfers.notes") }</label>
			<textarea id="transfer.notes" name="notes" maxlength="1000">{ typed.notes }</textarea>
		</div>
		if refusal != "" {
			<p id="transfer.refusal" class="refusal" role="alert">{ p.words.Of(refusal) }</p>
		}
		<span id="transfer.actions" class="details-actions">
			<button id="transfer.save" class="primary small" type="submit">{ p.words.Of("transfers.save") }</button>
		</span>
	</form>
}

// countPage is Update the actual balances as the app's screen asks it (FR-24): each account's actual balance, its books' balance under it; then
// the total and the difference as typed, and why it could not be kept.
templ countPage(p page, shown count) {
	<div class="view-head">
		<h2 id="reconcile.title">{ p.words.Of("reconciliations.enterTitle") }</h2>
	</div>
	<form id="reconcile.form" class="count-form" hx-post="/count" hx-target="[id='web.content']">
		if shown.refusal != "" {
			<p id="reconcile.message" class="refusal" role="alert">{ p.words.Of(shown.refusal) }</p>
		}
		for _, balance := range shown.latest.Balances {
			<div class="field">
				<label id={ "reconcile.balance." + balance.AccountID.String() + ".label" } for={ "reconcile.balance." + balance.AccountID.String() }>{ balance.AccountName }</label>
				<input
					id={ "reconcile.balance." + balance.AccountID.String() }
					name={ "balance." + balance.AccountID.String() }
					inputmode="decimal"
					value={ shown.typed[balance.AccountID] }
					hx-get="/count-figures"
					hx-include="closest form"
					hx-trigger="change"
					hx-target="[id='reconcile.figures']"
					hx-swap="outerHTML"
				/>
				<small id={ "reconcile.books." + balance.AccountID.String() } class="hint">{ p.words.Of("reconciliations.books") + ": " + statement.Money(balance.BooksBalance.Number()) }</small>
			</div>
		}
		@countFiguresOf(p, shown)
		<span id="reconcile.actions" class="form-actions">
			<button id="reconcile.save" class="primary small" type="submit">{ p.words.Of("reconciliations.save") }</button>
		</span>
	</form>
}

// countFiguresOf is the count's total and difference as typed.
templ countFiguresOf(p page, shown count) {
	<div id="reconcile.figures" class="count-figures">
		<p id="reconcile.total">{ p.words.Of("reconciliations.actualTotal") + ": " + statement.Money(shown.total().Number()) }</p>
		<p id="reconcile.difference" class={ templ.KV("refused", shown.difference().Number() != 0) }>{ p.words.Of("reconciliations.difference") + ": " + statement.Money(shown.difference().Number()) }</p>
	</div>
}

// countNotOffered is the count's tab for whoever may not update the balances: what it needs.
templ countNotOffered(p page) {
	<div class="view-head">
		<h2 id="reconcile.title">{ p.words.Of("reconciliations.enterTitle") }</h2>
	</div>
	<p id="reconcile.message" class="hint">{ p.words.Of("permissions.moveMoney") }</p>
}

// accountHistoryPage is the account history as the app's screen shows it: a search, the account and the person to narrow by, then each line,
// newest first, with Show more while there is more.
templ accountHistoryPage(p page, shown history, listed accountsShown) {
	<div class="view-head">
		<h2 id="accountHistory.title">{ p.words.Of("accounts.history") }</h2>
		<span id="accountHistory.actions" class="head-actions">
			@searchToggle(p, "accountHistory.searchToggle", "/tab/accountHistory")
		</span>
	</div>
	if p.searching {
		<form
			id="accountHistory.filters"
			class="filters"
			hx-get="/tab/accountHistory"
			hx-target="[id='web.content']"
			hx-trigger="change, input changed delay:400ms from:[name='text'], submit"
		>
			<input id="accountHistory.searchOn" type="hidden" name="search" value="on"/>
			<input id="accountHistory.search" class="search" autofocus?={ p.searchOpened } type="search" name="text" placeholder={ p.words.Of("common.searchIn", p.words.Of("accounts.history")) } aria-label={ p.words.Of("common.searchIn", p.words.Of("accounts.history")) } value={ shown.query.Get("text") }/>
			<label id="accountHistory.accountChoice.label" class="pick-select">
				{ p.words.Of("expenses.account") }
				<select id="accountHistory.accountChoice" name="account">
					<option id="accountHistory.accountChoice.option.none" value="">{ p.words.Of("history.all") }</option>
					for _, account := range listed.accounts {
						<option id={ "accountHistory.account." + account.ID.String() } value={ account.ID.String() } selected?={ account.ID.String() == shown.query.Get("account") }>{ account.Name }</option>
					}
				</select>
			</label>
			@historyPerson(p, shown)
		</form>
	}
	@historyList(p, shown)
}
