package web

import (
	"strconv"
	"time"

	"github.com/MutebAlMughyiri/redix-api/go-backend/internal/accounts"
	"github.com/MutebAlMughyiri/redix-api/go-backend/internal/entries"
	"github.com/MutebAlMughyiri/redix-api/go-backend/internal/platform/fixed"
	"github.com/MutebAlMughyiri/redix-api/go-backend/internal/projects"
	"github.com/MutebAlMughyiri/redix-api/go-backend/internal/reports"
	"github.com/MutebAlMughyiri/redix-api/go-backend/internal/statement"
)

// home is the app's home in the content area (UC-049, redix-api #165): the project's name and the caller's role, the summary - folded by Hide
// details, kept with the shell's look - the custody they hold, and the newest entries. Add entry and Show more stand gray until their features
// are built.
templ home(p page, summary reports.Summary, custody []accounts.View, newest []entries.Row) {
	<div class="home-head">
		<h2 id="home.title">{ p.project.Name }</h2>
		if p.project.RoleName != "" {
			<span id="home.roleName" class="role">{ p.project.RoleName }</span>
		}
		<span class="end">
			<label id="home.collapse" class="quiet-button" for="web.view.summary">
				<span class="when-shown">{ p.words.Of("home.hideDetails") }</span>
				<span class="when-hidden">{ p.words.Of("home.showDetails") }</span>
			</label>
			<button id={ "home.addEntry." + p.project.ID.String() } class="primary small" type="button" disabled>{ p.words.Of("entries.new") }</button>
		</span>
	</div>
	<div class="home">
		<section id="summary.card" class="card summary">
			if p.waitsForMe(summary) {
				<div id="summary.pending" class="pending">
					<strong>{ p.words.Of("summary.pending", strconv.FormatInt(summary.Waiting.ExpensesCount+summary.Waiting.RevenueCount, 10)) }</strong>
					if summary.Waiting.ExpensesCount > 0 {
						<small>{ p.words.Of("reports.pendingExpenses") } ({ strconv.FormatInt(summary.Waiting.ExpensesCount, 10) }): { money(summary.Waiting.ExpensesAmount) }</small>
					}
					if summary.Waiting.RevenueCount > 0 {
						<small>{ p.words.Of("reports.pendingRevenue") } ({ strconv.FormatInt(summary.Waiting.RevenueCount, 10) }): { money(summary.Waiting.RevenueAmount) }</small>
					}
				</div>
			}
			<span id="summary.surplus.label" class="label">{ p.words.Of("summary.surplus") }</span>
			<span id="summary.surplus" class="surplus">{ money(summary.Surplus) } <small>{ p.words.Of("accounts.riyal") }</small></span>
			<span id="summary.completion" class="label">{ p.words.Of("summary.completion") }: { string(summary.CompletionPercent) }%</span>
			<progress id="summary.completionBar" class="bar" max="100" value={ string(summary.CompletionPercent) }></progress>
			if summary.WasReconciled {
				<span id="summary.difference" class="label">{ p.words.Of("summary.difference") }: { money(summary.ReconciliationDifference) }</span>
			}
			<div class="tiles">
				@summarySide(p, "revenue", summary.Revenue, summary.RevenueCategories)
				@summarySide(p, "expenses", summary.Expenses, summary.Categories)
			</div>
		</section>
		<div class="side-col">
			for _, account := range custody {
				<section id={ "home.custody." + account.ID.String() } class="card custody">
					<span class="label">{ p.words.Of("accounts.myCustody") } · { account.Name }</span>
					<b id={ "home.custodyBalance." + account.ID.String() }>{ money(account.Balance) } { p.words.Of("accounts.riyal") }</b>
				</section>
			}
			<h3 id={ "home.entriesHeading." + p.project.ID.String() } class="latest-head">{ p.words.Of("entries.title") }</h3>
			if len(newest) == 0 {
				<p id={ "home.entriesEmpty." + p.project.ID.String() } class="empty">{ p.words.Of("entries.empty") }</p>
			} else {
				@entryRows(p, newest)
				<span id={ "home.moreEntries." + p.project.ID.String() } class="parked more" aria-disabled="true">{ p.words.Of("entries.showMore") }</span>
			}
		</div>
	</div>
}

// summarySide is Revenue or Expenses with its total, opening on its categories with each one's share; the two share one name, so opening one
// closes the other, as the app's tiles do, with the browser's own disclosure and no script.
templ summarySide(p page, side string, total fixed.Total, categories []reports.CategoryTotal) {
	<details id={ "summary." + side + ".card" } class="tile" name="summary.side">
		<summary id={ "summary." + side + ".body" }>
			<span class="label">{ p.words.Of("summary." + side) }</span>
			<b id={ "summary." + side }>{ money(total) }</b>
		</summary>
		<ul class="shares">
			for _, category := range categories {
				<li id={ "summary.category." + category.ID.String() }>
					<span>{ category.Name }</span>
					<span class="figure">{ money(category.Total) } · { strconv.Itoa(share(category.Total, total)) }%</span>
					<progress class="bar" max="100" value={ strconv.Itoa(share(category.Total, total)) }></progress>
				</li>
			}
		</ul>
	</details>
}

// entryRows are entries as the app's lists show them: number, date, the item or the partner, the supplier, the status and the amount.
templ entryRows(p page, rows []entries.Row) {
	<div class="grid-wrap">
		<table class="grid">
			<thead>
				<tr>
					<th>{ p.words.Of("entries.number") }</th>
					<th>{ p.words.Of("expenses.date") }</th>
					<th>{ p.words.Of("contracts.item") }</th>
					<th>{ p.words.Of("expenses.supplier") }</th>
					<th>{ p.words.Of("entries.status") }</th>
					<th class="amount">{ p.words.Of("expenses.amount") }</th>
				</tr>
			</thead>
			<tbody>
				for _, row := range rows {
					<tr id={ "entries.row." + row.ID.String() }>
						<td>{ strconv.FormatInt(row.Number, 10) }</td>
						<td>{ row.EntryDate.Format(time.DateOnly) }</td>
						<td>{ entryTitle(row) }</td>
						<td>{ row.SupplierName }</td>
						<td><span class={ "state", row.Status.Name() }>{ p.words.Of("entries." + row.Status.Name()) }</span></td>
						<td class="amount">{ statement.Money(row.Amount) }</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
}

// projectList is the caller's projects while they choose one, as the app lands on its list (redix-api #165); one they may not open stands gray.
templ projectList(p page) {
	<div class="view-head"><h2 id="projects.title">{ p.words.Of("projects.choose") }</h2></div>
	<p id="projects.hint" class="hint">{ p.words.Of("projects.chooseHint") }</p>
	if len(p.projects) == 0 {
		<p id="projects.empty" class="empty">{ p.words.Of("projects.empty") }</p>
	}
	<div class="cards">
		for _, project := range p.projects {
			@projectChoice(p, project, "projects.card.")
		}
	</div>
}

// projectChoice is one project to choose, its status beside its name; choosing it opens its home in the whole shell.
templ projectChoice(p page, project projects.View, idPrefix string) {
	<button
		id={ idPrefix + project.ID.String() }
		class="choice"
		type="button"
		hx-post={ "/project/" + project.ID.String() }
		hx-target="[id='web.shell']"
		hx-swap="outerHTML"
		aria-current={ strconv.FormatBool(project.ID == p.project.ID) }
		disabled?={ !mayOpen(project) }
	>
		<span>{ project.Name }</span>
		if project.IsInactive {
			<small>{ p.words.Of("projects.inactive") }</small>
		}
		<span class={ "state", project.Status }>{ p.words.Of(statusWord(project.Status)) }</span>
	</button>
}

