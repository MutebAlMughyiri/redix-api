package web

import (
	"strconv"
	"time"

	"github.com/MutebAlMughyiri/redix-api/go-backend/internal/accounts"
	"github.com/MutebAlMughyiri/redix-api/go-backend/internal/entries"
	"github.com/MutebAlMughyiri/redix-api/go-backend/internal/platform/fixed"
	"github.com/MutebAlMughyiri/redix-api/go-backend/internal/projects"
	"github.com/MutebAlMughyiri/redix-api/go-backend/internal/reports"
	"github.com/MutebAlMughyiri/redix-api/go-backend/internal/statement"
)

// home is the project's home in the content area (UC-049, redix-api #165): the project's name and the caller's role, the summary, always open,
// and the custody they hold; Add entry for whoever may enter expenses. The owner's web home (23 Nov 2026, findings rows 306, 310): in the middle
// of the page, no Hide details, Revenue and Expenses never folded, and no newest entries, which Entries lists; the app's home keeps its own.
templ home(p page, summary reports.Summary, custody []accounts.View) {
	<div id="home.page" class="home-page">
		<div class="home-head">
			<h2 id="home.title">{ p.project.Name }</h2>
			if p.project.RoleName != "" {
				<span id="home.roleName" class="role">{ p.project.RoleName }</span>
			}
			<span id="home.headEnd" class="end">
				<button id={ "home.addEntry." + p.project.ID.String() } class="primary small" type="button" disabled?={ !p.mayEnterExpenses() } title={ p.words.Of("permissions.recordEntries") } hx-get="/tab/addEntry" hx-target="[id='web.content']">{ p.words.Of("entries.new") }</button>
			</span>
		</div>
		<div class="home">
			<section id="summary.card" class="card summary">
				if p.waitsForMe(summary) {
					<div id="summary.pending" class="pending">
						<strong id="summary.pendingCount">{ p.words.Of("summary.pending", strconv.FormatInt(summary.Waiting.ExpensesCount+summary.Waiting.RevenueCount, 10)) }</strong>
						if summary.Waiting.ExpensesCount > 0 {
							<small id="summary.pendingExpenses">{ p.words.Of("reports.pendingExpenses") } ({ strconv.FormatInt(summary.Waiting.ExpensesCount, 10) }): { money(summary.Waiting.ExpensesAmount) }</small>
						}
						if summary.Waiting.RevenueCount > 0 {
							<small id="summary.pendingRevenue">{ p.words.Of("reports.pendingRevenue") } ({ strconv.FormatInt(summary.Waiting.RevenueCount, 10) }): { money(summary.Waiting.RevenueAmount) }</small>
						}
					</div>
				}
				<span id="summary.surplus.label" class="label">{ p.words.Of("summary.surplus") }</span>
				<span id="summary.surplus" class="surplus">{ money(summary.Surplus) } <small id="summary.surplus.currency">{ p.words.Of("accounts.riyal") }</small></span>
				<span id="summary.completion" class="label">{ p.words.Of("summary.completion") }: { string(summary.CompletionPercent) }%</span>
				<progress id="summary.completionBar" class="bar" max="100" value={ string(summary.CompletionPercent) }></progress>
				if summary.WasReconciled {
					<span id="summary.difference" class="label">{ p.words.Of("summary.difference") }: { money(summary.ReconciliationDifference) }</span>
				}
				<div class="tiles">
					@summarySide(p, "revenue", summary.Revenue, summary.RevenueCategories)
					@summarySide(p, "expenses", summary.Expenses, summary.Categories)
				</div>
			</section>
			for _, account := range custody {
				<section id={ "home.custody." + account.ID.String() } class="card custody">
					<span id={ "home.custodyName." + account.ID.String() } class="label">{ p.words.Of("accounts.myCustody") } · { account.Name }</span>
					<b id={ "home.custodyBalance." + account.ID.String() }>{ money(account.Balance) } { p.words.Of("accounts.riyal") }</b>
				</section>
			}
		</div>
	</div>
}

// summarySide is Revenue or Expenses with its total and every category with its share, always shown: the owner's web home folds none (23 Nov
// 2026, findings row 310), where the app's tiles open one at a time.
templ summarySide(p page, side string, total fixed.Total, categories []reports.CategoryTotal) {
	<section id={ "summary." + side + ".card" } class="tile">
		<div id={ "summary." + side + ".body" } class="tile-head">
			<span id={ "summary." + side + ".label" } class="label">{ p.words.Of("summary." + side) }</span>
			<b id={ "summary." + side }>{ money(total) }</b>
		</div>
		<ul id={ "summary." + side + ".shares" } class="shares">
			for _, category := range categories {
				<li id={ "summary.category." + category.ID.String() }>
					<span id={ "summary.category." + category.ID.String() + ".name" }>{ category.Name }</span>
					<span id={ "summary.category." + category.ID.String() + ".figure" } class="figure">{ money(category.Total) } · { strconv.Itoa(share(category.Total, total)) }%</span>
					<progress id={ "summary.category." + category.ID.String() + ".share" } class="bar" max="100" value={ strconv.Itoa(share(category.Total, total)) }></progress>
				</li>
			}
		</ul>
	</section>
}

// entryRows are entries as the app's lists show them: number, date, the item or the partner, the supplier, the status and the amount; a click or
// Enter shows one in the details panel, and the list's keys move along them (redix-api #166).
templ entryRows(p page, rows []entries.Row) {
	<div class="grid-wrap">
		<table id="entries.table" class="grid" hx-on:keydown={ templ.JSUnsafeFuncCall(listKeys) } hx-on:click={ templ.JSUnsafeFuncCall(listSelects) }>
			<thead>
				<tr>
					<th id="entries.head.number">{ p.words.Of("entries.number") }</th>
					<th id="entries.head.date">{ p.words.Of("expenses.date") }</th>
					<th id="entries.head.item">{ p.words.Of("contracts.item") }</th>
					<th id="entries.head.supplier">{ p.words.Of("expenses.supplier") }</th>
					<th id="entries.head.status">{ p.words.Of("entries.status") }</th>
					<th id="entries.head.amount" class="amount">{ p.words.Of("expenses.amount") }</th>
				</tr>
			</thead>
			<tbody>
				for _, row := range rows {
					@entryRow(p, row, false)
				}
			</tbody>
		</table>
	</div>
}

// entryRow is an entry on a list; an action's answer carries it out of band in rowBeside, so the list shows what the action did.
templ entryRow(p page, row entries.Row, outOfBand bool) {
	<tr
		id={ "entries.row." + row.ID.String() }
		tabindex="0"
		aria-selected="false"
		hx-get={ "/details/entry/" + row.ID.String() }
		hx-target="[id='web.details']"
		{ swapOutOfBand(outOfBand)... }
	>
		<td id={ "entries.number." + row.ID.String() }>{ strconv.FormatInt(row.Number, 10) }</td>
		<td id={ "entries.date." + row.ID.String() }>{ row.EntryDate.Format(time.DateOnly) }</td>
		<td id={ "entries.item." + row.ID.String() }>{ entryTitle(row) }</td>
		<td id={ "entries.supplier." + row.ID.String() }>{ row.SupplierName }</td>
		<td id={ "entries.status." + row.ID.String() }><span id={ "entries.status." + row.ID.String() + ".chip" } class={ "state", row.Status.Name() }>{ p.words.Of("entries." + row.Status.Name()) }</span></td>
		<td id={ "entries.amount." + row.ID.String() } class="amount">{ statement.Money(row.Amount) }</td>
	</tr>
}

// projectList is the caller's projects while they choose one, as the app lands on its list (redix-api #165); one they may not open stands gray.
templ projectList(p page) {
	<div class="view-head"><h2 id="projects.title">{ p.words.Of("projects.choose") }</h2></div>
	<p id="projects.hint" class="hint">{ p.words.Of("projects.chooseHint") }</p>
	if len(p.projects) == 0 {
		<p id="projects.empty" class="empty">{ p.words.Of("projects.empty") }</p>
	}
	<div class="cards">
		for _, project := range p.projects {
			@projectChoice(p, project, "projects.card.")
		}
	</div>
}

// projectMenu is the top bar's list of the caller's projects, each with its star, the default one filled (AC-37.1); notice says what a star just
// did. A star answers this list in place, so it stays open.
templ projectMenu(p page, notice string) {
	<h4 id="web.projects.title">{ p.words.Of("projects.choose") }</h4>
	if notice != "" {
		<p id="web.projects.notice" class="notice" role="status">{ notice }</p>
	}
	for _, project := range p.projects {
		<div class="menu-row">
			@projectChoice(p, project, "web.projects.")
			if mayOpen(project) {
				<button
					id={ "projects.star." + project.ID.String() }
					class="star"
					type="button"
					title={ p.words.Of("projects.defaultProject") }
					aria-label={ p.words.Of("projects.defaultProject") }
					aria-pressed={ strconv.FormatBool(project.ID == p.defaultProject) }
					hx-post={ "/project/" + project.ID.String() + "/default" }
					hx-target="[id='web.projects']"
					hx-swap="innerHTML"
				>
					if project.ID == p.defaultProject {
						★
					} else {
						☆
					}
				</button>
			}
		</div>
	}
	<a id="projects.new" class="menu-link" href="#" hx-get="/tab/registerProject" hx-target="[id='web.content']" hx-on:click="document.getElementById('web.projects').hidePopover()">{ p.words.Of("projects.new") }</a>
}

// projectMenuBeside is the project menu carried out of band beside an answer that changed the projects it lists.
templ projectMenuBeside(p page) {
	<div id="web.projects" hx-swap-oob="innerHTML">
		@projectMenu(p, "")
	</div>
}

// projectChoice is one project to choose, its status beside its name; choosing it opens its home in the whole shell.
templ projectChoice(p page, project projects.View, idPrefix string) {
	<button
		id={ idPrefix + project.ID.String() }
		class="choice"
		type="button"
		hx-post={ "/project/" + project.ID.String() }
		hx-target="[id='web.shell']"
		hx-swap="outerHTML"
		aria-current={ strconv.FormatBool(project.ID == p.project.ID) }
		disabled?={ !mayOpen(project) }
	>
		<span id={ idPrefix + project.ID.String() + ".name" }>{ project.Name }</span>
		if project.IsInactive {
			<small id={ idPrefix + project.ID.String() + ".inactive" }>{ p.words.Of("projects.inactive") }</small>
		}
		<span id={ idPrefix + project.ID.String() + ".status" } class={ "state", project.Status }>{ p.words.Of(statusWord(project.Status)) }</span>
	</button>
}
