package web

import (
	"strconv"

	"github.com/google/uuid"

	"github.com/MutebAlMughyiri/redix-api/go-backend/internal/access"
	"github.com/MutebAlMughyiri/redix-api/go-backend/internal/entries"
	"github.com/MutebAlMughyiri/redix-api/go-backend/internal/statement"
	"github.com/MutebAlMughyiri/redix-api/go-backend/internal/structure"
	"github.com/MutebAlMughyiri/redix-api/go-backend/internal/suppliers"
)

// addEntry is Add entry as the app's screen asks it (UC-022, redix-api #166): the file, for whoever may attach files (#175 D3), the table, the
// description, the date and
// the amount; inside or outside a contract's agreement, a purchase's supplier, the item's own columns; the payment method and the account; then
// Save draft and Send. Changing the table, the method or the supplier search draws the form again with what was typed, the file field outside
// it, joined by form=, so a file chosen stays chosen.
templ addEntry(p page, form entryForm) {
	<div class="view-head">
		<h2 id="addEntry.title">{ p.words.Of(form.title()) }</h2>
		if form.editing.ID != uuid.Nil {
			<span id="addEntry.number" class="hint">{ p.words.Of("entries.numberOf", strconv.FormatInt(form.editing.Number, 10)) }</span>
		}
	</div>
	if form.table.ID == uuid.Nil {
		<p id="addEntry.message" class="hint">{ p.words.Of("entries.noTableMatch") }</p>
	} else {
		if p.may(access.AttachFiles) {
			<div id="addEntry.fileSection" class="entry-form">
				<div class="field wide">
					<label id="addEntry.file.label" for="addEntry.file">{ p.words.Of(form.fileWord()) }</label>
					<input id="addEntry.file" form="addEntry.form" name="file" type="file" accept="image/jpeg,image/png,application/pdf"/>
					if form.file.ID != uuid.Nil {
						<input form="addEntry.form" type="hidden" name="attachment" value={ form.file.ID.String() }/>
						<small id="addEntry.fileKept" class="hint">{ form.file.FileName }</small>
					}
				</div>
			</div>
		}
		<form id="addEntry.form" class="entry-form" hx-post={ form.action() } hx-encoding="multipart/form-data" hx-target="[id='web.content']" hx-sync="this:drop">
			if form.editing.ID != uuid.Nil {
				<input type="hidden" name="entry" value={ form.editing.ID.String() }/>
			}
			<div class="field wide">
				<label id="addEntry.table.label" for="addEntry.table">{ p.words.Of("entries.table") }</label>
				<select id="addEntry.table" name="table" hx-get={ form.tab() } hx-include="closest form" hx-target="[id='addEntry.form']" hx-select="[id='addEntry.form']" hx-swap="outerHTML">
					for _, category := range form.tables {
						<optgroup label={ category.Name }>
							for _, item := range category.Items {
								for _, table := range item.Tables {
									<option id={ "addEntry.table.option." + tableValue(item, table) } value={ tableValue(item, table) } selected?={ item.ID == form.item.ID && table.ID == form.table.ID }>{ tableLabel(item, table) }</option>
								}
							}
						</optgroup>
					}
				</select>
			</div>
			<div class="field wide">
				<label id="addEntry.description.label" for="addEntry.description">{ p.words.Of("expenses.description") }</label>
				<input id="addEntry.description" name="description" value={ form.typed.Get("description") }/>
			</div>
			<div class="field">
				<label id="addEntry.date.label" for="addEntry.date">{ p.words.Of("expenses.date") }</label>
				<input id="addEntry.date" name="date" type="date" value={ form.typed.Get("date") }/>
			</div>
			<div class="field">
				<label id="addEntry.amount.label" for="addEntry.amount">{ p.words.Of("expenses.amount") }</label>
				<input id="addEntry.amount" name="amount" inputmode="decimal" value={ form.typed.Get("amount") } aria-invalid?={ form.said.refusal == "expenses.invalidAmount" } { form.figuresFollow()... }/>
			</div>
			if form.asksContract() {
				@contractFigures(p, form)
				<fieldset id="addEntry.kind" class="picks wide">
					<legend id="addEntry.kind.label">{ p.words.Of("contractorPayments.kind") }</legend>
					<label id="addEntry.inside" class="pick"><input id="addEntry.inside.input" type="radio" name="outside" value="false" checked?={ form.typed.Get("outside") != "true" } { form.figuresFollow()... }/>{ p.words.Of("contractorPayments.inside") }</label>
					<label id="addEntry.outside" class="pick"><input id="addEntry.outside.input" type="radio" name="outside" value="true" checked?={ form.typed.Get("outside") == "true" } { form.figuresFollow()... }/>{ p.words.Of("contractorPayments.outside") }</label>
					<small id="addEntry.outsideExplain" class="hint">{ p.words.Of("contractorPayments.outsideExplain") }</small>
				</fieldset>
			}
			if form.asksSupplier() {
				<div class="field wide">
					<label id="addEntry.supplier.label" for="addEntry.supplier">{ p.words.Of("expenses.supplier") }</label>
					<span id="addEntry.supplierChoice" class="pair">
						<input id="addEntry.supplierSearch" class="search" type="search" name="supplierText" value={ form.typed.Get("supplierText") } placeholder={ p.words.Of("common.search") } aria-label={ p.words.Of("common.search") } hx-get={ form.tab() } hx-include="closest form" hx-target="[id='addEntry.form']" hx-select="[id='addEntry.form']" hx-swap="outerHTML" hx-trigger="input changed delay:400ms"/>
						<select id="addEntry.supplier" name="supplier">
							<option id="addEntry.supplier.option.none" value=""></option>
							for _, supplier := range form.suppliers {
								<option id={ "addEntry.supplier.option." + supplier.ID.String() } value={ supplier.ID.String() } selected?={ supplier.ID.String() == form.typed.Get("supplier") }>{ supplier.Name }</option>
							}
						</select>
						if p.mayAddSupplier() && !form.quickAdding() {
							<button id="addEntry.quickAddOpen" class="quiet-button" type="button" hx-get={ form.tab() } hx-include="closest form" hx-vals='{"quickAdd":"1"}' hx-target="[id='addEntry.form']" hx-select="[id='addEntry.form']" hx-swap="outerHTML">{ p.words.Of("suppliers.quickAdd") }</button>
						}
					</span>
				</div>
				if p.mayAddSupplier() && form.quickAdding() {
					@quickAddSupplier(p, form.tab(), form.quickAddName(), form.quickAddVatNumber(), "", suppliers.View{})
				}
			}
			if len(form.columns) > 0 {
				<p id="addEntry.columnsSection" class="section-title wide">{ p.words.Of("columns.title") }</p>
				for _, column := range form.columns {
					@columnField(form, column)
				}
			}
			if !form.item.IsRevenue {
				<fieldset id="payment.methodChoice" class="picks wide">
					<legend id="payment.methodChoice.label">{ p.words.Of("expenses.paymentMethod") }</legend>
					for _, method := range form.methods {
						<label id={ "payment.method." + method.ID.String() } class="pick"><input type="radio" name="method" value={ method.ID.String() } checked?={ method.ID == form.method } hx-get={ form.tab() } hx-include="closest form" hx-target="[id='addEntry.form']" hx-select="[id='addEntry.form']" hx-swap="outerHTML"/>{ method.Name }</label>
					}
				</fieldset>
			}
			<fieldset id="addEntry.paymentSection" class="picks wide">
				<legend id="addEntry.paymentSection.label">{ p.words.Of("expenses.account") }</legend>
				for _, account := range form.accounts {
					<label id={ "payment.account." + account.ID.String() } class="pick"><input id={ "payment.account." + account.ID.String() + ".input" } type="radio" name="account" value={ account.ID.String() } checked?={ account.ID == form.account() }/>{ account.Name }</label>
				}
				if len(form.accounts) == 0 {
					<p id="payment.noAccount" class="hint">{ p.words.Of("expenses.noAccount") }</p>
				}
			</fieldset>
			if form.said.notice != "" {
				<p id="addEntry.message" class="notice wide" role="status">{ p.words.Of(form.said.notice) }</p>
			}
			if form.said.refusal != "" {
				<p id="addEntry.message" class="refusal wide" role="alert">{ p.words.Of(form.said.refusal) }</p>
			}
			<div class="form-actions wide">
				<button id="addEntry.draft" class="quiet-button" type="submit" name="submit" value="draft">{ p.words.Of("expenses.saveDraft") }</button>
				<button id="addEntry.send" class="primary small" type="submit" name="submit" value="send">{ p.words.Of("expenses.send") }</button>
			</div>
		</form>
		<form id="addEntry.quickAddForm" hx-post="/entry/supplier" hx-include="[id='addEntry.form']" hx-target="[id='addEntry.quickAdd']" hx-swap="outerHTML"></form>
	}
}

// columnField is one of the item's own columns as the app's ColumnValueField draws it: a list a dropdown of its choices, a date a date, a
// number typed as a decimal, anything else as text; the column the last save refused is marked.
templ columnField(form entryForm, column structure.ColumnView) {
	<div class="field">
		<label id={ "addEntry.column." + column.Key + ".label" } for={ "addEntry.column." + column.Key } class={ templ.KV("required", column.IsRequired) }>{ column.Name }</label>
		switch  {
			case column.DataType == structure.List && len(column.Choices) > 0:
				<select id={ "addEntry.column." + column.Key } name={ "column." + column.Key } aria-invalid?={ form.refused == column.Key }>
					<option id={ "addEntry.column." + column.Key + ".option.none" } value=""></option>
					for _, choice := range column.Choices {
						<option id={ "addEntry.columnOption." + column.Key + "." + choice.ID.String() } value={ choice.ID.String() } selected?={ choice.ID.String() == form.typed.Get("column." + column.Key) }>{ choice.Name }</option>
					}
				</select>
			case column.DataType == structure.Date:
				<input id={ "addEntry.column." + column.Key } name={ "column." + column.Key } type="date" value={ form.typed.Get("column." + column.Key) } aria-invalid?={ form.refused == column.Key }/>
			case column.DataType == structure.Number || column.DataType == structure.Amount:
				<input id={ "addEntry.column." + column.Key } name={ "column." + column.Key } inputmode="decimal" value={ form.typed.Get("column." + column.Key) } aria-invalid?={ form.refused == column.Key }/>
			default:
				<input id={ "addEntry.column." + column.Key } name={ "column." + column.Key } value={ form.typed.Get("column." + column.Key) } aria-invalid?={ form.refused == column.Key }/>
		}
	</div>
}

// panelBeside is an entry in the details panel, carried out of band beside the answer that recorded it.
templ panelBeside(p page, row entries.Row) {
	@detailsPanel(true) {
		@entryPanel(p, row, said{})
	}
}

// entryNotChangeable is Change's tab for an entry that is gone, or that the caller may no longer change.
templ entryNotChangeable(p page) {
	<div class="view-head">
		<h2 id="addEntry.title">{ p.words.Of("entries.edit") }</h2>
	</div>
	<p id="addEntry.message" class="hint">{ p.words.Of("approvals.unknownEntry") }</p>
}

// contractFigures is a contract payment's figures as the app's ContractFigures shows them: the value - open for a contract of no set value -, what
// is paid, what remains after this payment, what waits beside it, a bar of how far the contract is reached, and a warning when the payment goes
// beyond the value, which still saves (BR-07).
templ contractFigures(p page, form entryForm) {
	<div id="addEntry.figures" class="figures wide">
		<dl class="facts">
			<dt id="addEntry.value.label">{ p.words.Of("contracts.value") }</dt>
			if form.contract.IsOpenValue {
				<dd id="addEntry.value">{ p.words.Of("contracts.open") }</dd>
			} else {
				<dd id="addEntry.value" class="money">{ statement.Money(form.contract.Value) }</dd>
			}
			<dt id="addEntry.paid.label">{ p.words.Of("contracts.paid") }</dt>
			<dd id="addEntry.paid" class="money">{ statement.Money(form.standing.Paid.Number()) }</dd>
			if !form.contract.IsOpenValue {
				<dt id="addEntry.remaining.label">{ p.words.Of("contractorPayments.remainingAfter") }</dt>
				<dd id="addEntry.remaining" class={ "money", templ.KV("refused", form.standing.IsOverrun) }>{ statement.Money(form.standing.RemainingAfter.Number()) }</dd>
			}
		</dl>
		if form.standing.Pending.Number() != 0 {
			<p id="addEntry.pending" class="hint">{ p.words.Of("contracts.pending") + " " + statement.Money(form.standing.Pending.Number()) }</p>
		}
		if !form.contract.IsOpenValue {
			<progress id="addEntry.progress" class="bar" max="100" value={ form.progress() }></progress>
		}
		if form.standing.IsOverrun {
			<p id="addEntry.overrun" class="refusal">{ p.words.Of("contractorPayments.overrun") }</p>
		}
	</div>
}

// quickAddSupplier is Quick add under the supplier, as the app's dialog asks it (UC-019): the name and the VAT number, starting from what the
// search held; why it was refused, naming the supplier a VAT number belongs to and offering that one when it is active; the hint that the
// supplier waits for approval, for whoever does not keep the settings. Its fields belong to addEntry.quickAddForm, so Enter adds the supplier,
// not the entry; tab is the tab the form lives in, drawn again to pick the supplier or to close Quick add.
templ quickAddSupplier(p page, tab, name, vatNumber, refusal string, holder suppliers.View) {
	<fieldset id="addEntry.quickAdd" class="quick-add wide">
		<legend id="addEntry.quickAdd.label">{ p.words.Of("suppliers.quickAdd") }</legend>
		<input type="hidden" name="quickAdd" value="1"/>
		<div class="field">
			<label id="addEntry.quickAddName.label" for="addEntry.quickAddName">{ p.words.Of("suppliers.name") }</label>
			<input id="addEntry.quickAddName" form="addEntry.quickAddForm" type="text" name="quickAddName" value={ name } autofocus/>
		</div>
		<div class="field">
			<label id="addEntry.quickAddVatNumber.label" for="addEntry.quickAddVatNumber">{ p.words.Of("suppliers.vatNumber") }</label>
			<input id="addEntry.quickAddVatNumber" form="addEntry.quickAddForm" type="text" inputmode="numeric" name="quickAddVatNumber" value={ vatNumber }/>
		</div>
		if refusal != "" {
			<p id="addEntry.quickAddRefusal" class="refusal" role="alert">{ p.words.Of(refusal) }</p>
		}
		if holder.Name != "" {
			<small id="addEntry.quickAddHolder" class="hint">{ p.words.Of("suppliers.holder") + " " + holder.Name }</small>
		}
		if !p.may(access.ManageSettings) {
			<small id="addEntry.quickAddPendingHint" class="hint">{ p.words.Of("suppliers.pendingHint") }</small>
		}
		<div class="form-actions">
			if holder.IsActive {
				<button id="addEntry.quickAddUseExisting" class="quiet-button" type="button" hx-get={ tab } hx-include="[id='addEntry.form']" hx-vals={ picked(holder) } hx-target="[id='addEntry.form']" hx-select="[id='addEntry.form']" hx-swap="outerHTML">{ p.words.Of("suppliers.useExisting") }</button>
			}
			<button id="addEntry.quickAddCancel" class="quiet-button" type="button" hx-get={ tab } hx-include="[id='addEntry.form']" hx-vals='{"quickAdd":""}' hx-target="[id='addEntry.form']" hx-select="[id='addEntry.form']" hx-swap="outerHTML">{ p.words.Of("common.cancel") }</button>
			<button id="addEntry.quickAddSave" class="primary small" type="submit" form="addEntry.quickAddForm">{ p.words.Of("suppliers.addAndPick") }</button>
		</div>
	</fieldset>
}
